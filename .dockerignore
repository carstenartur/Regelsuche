# Exclude VCS and IDE noise from the Docker build context.
.git
.gitignore
.gitattributes
.github
.idea
.vscode
*.iml

# Local build artefacts (rebuilt inside the image).
**/build
**/.gradle
**/out
**/bin

# Logs, OS junk, editor backups.
*.log
.DS_Store
Thumbs.db

# Gradle build definitions may declare public JSON schemas as verification
# inputs even when an image target only runs installDist. Keep the schemas in
# the isolated build context, together with the frozen comparative evidence.
docs/**
!docs/schemas/
!docs/schemas/**
!docs/evidence/
docs/evidence/**
!docs/evidence/autopilot-controller-comparison-v1.json.gz
!docs/evidence/discovery-component-panel-exact-v1.json.gz
!docs/evidence/discovery-component-panel-v1.json.gz
!docs/evidence/open-target-fan-in-v1.json.gz
!docs/autopilot-controller-comparison.md
!docs/discovery-component-panel-protocol.md
!docs/open-target-fan-in-control.md

# Maven's distribution descriptor includes these public, tracked files.
# Keep them in the isolated Docker context for the proof-image Maven build.
LICENSE
README.md
!LICENSE
!README.md
!python/LICENSE
!python/README.md
!docs/python-client.md
