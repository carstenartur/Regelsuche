# Exclude VCS and IDE noise from the Docker build context.
.git
.gitignore
.gitattributes
.github
.idea
.vscode
*.iml

# Local build artefacts (rebuilt inside the image).
**/build
**/.gradle
**/out
**/bin

# Logs, OS junk, editor backups.
*.log
.DS_Store
Thumbs.db

# Gradle build definitions may declare public JSON schemas as verification
# inputs even when an image target only runs installDist. Keep the schemas in
# the isolated build context, but continue to exclude documentation media and
# prose from application images.
docs/**
!docs/schemas/
!docs/schemas/**

LICENSE
README.md
