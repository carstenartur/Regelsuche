<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.carstenartur</groupId>
    <artifactId>regelsuche-parent</artifactId>
    <version>0.5.4-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>regelsuche-quality</artifactId>
  <name>Regelsuche Quality Evidence</name>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jacoco</groupId>
      <artifactId>org.jacoco.report</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
            <regelsuche.maven.reactor>true</regelsuche.maven.reactor>
            <regelsuche.quality.outputDirectory>${project.build.directory}/reports/quality/jmh-history</regelsuche.quality.outputDirectory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <id>replay-original-jmh-ci-decisions</id>
            <goals><goal>integration-test</goal><goal>verify</goal></goals>
            <configuration>
              <test>de.regelsuche.quality.jmh.JmhRetainedCiReplayIT</test>
              <failIfNoTests>true</failIfNoTests>
              <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
              <systemPropertyVariables>
                <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>verify-cross-authority-coverage</id>
      <properties>
        <regelsuche.coverage.isolatedReport>build/authority-evidence/sympy/regelsuche-math-sympy/build/reports/jacoco/test/jacocoTestReport.xml</regelsuche.coverage.isolatedReport>
        <regelsuche.coverage.publish>false</regelsuche.coverage.publish>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-split-coverage</id>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.coverage.IsolatedCoverageInputTest#verifyRetainedSplitCoverage</test>
                  <!-- The CI join skips the ordinary Surefire suite. -->
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables>
                    <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
                    <regelsuche.coverage.isolatedReport>${regelsuche.coverage.isolatedReport}</regelsuche.coverage.isolatedReport>
                    <regelsuche.coverage.publish>${regelsuche.coverage.publish}</regelsuche.coverage.publish>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>verify-jmh-allocation-result</id>
      <activation><property><name>regelsuche.jmh.allocationResult</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-jmh-allocation</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.jmh.JmhAllocationMavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables combine.children="append">
                    <regelsuche.jmh.allocationSummary>${project.build.directory}/reports/quality/jmh-allocation/allocation.json</regelsuche.jmh.allocationSummary>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>verify-jmh-publication-result</id>
      <activation><property><name>regelsuche.jmh.publicationResult</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-jmh-publication</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.jmh.JmhPublicationMavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables combine.children="append">
                    <regelsuche.jmh.publicationOutput>${project.build.directory}/reports/quality/jmh-publication</regelsuche.jmh.publicationOutput>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>verify-jmh-regression-v3-result</id>
      <activation><property><name>regelsuche.jmh.regressionResult</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-jmh-regression-v3</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.jmh.JmhRegressionV3MavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables combine.children="append">
                    <regelsuche.jmh.regressionOutput>${project.build.directory}/reports/quality/jmh-regression-v3</regelsuche.jmh.regressionOutput>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <!-- Explicit replay after a successful Maven reactor; never rerun tests or infer gate success. -->
      <id>render-maven-test-pages</id>
      <activation><property><name>regelsuche.tests.mavenPages</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <executions>
              <execution>
                <id>render-retained-maven-test-pages</id>
                <goals><goal>integration-test</goal><goal>verify</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.coverage.CiPagesMavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables>
                    <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
                    <regelsuche.tests.mavenPages>true</regelsuche.tests.mavenPages>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
