<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.regelsuche</groupId>
    <artifactId>regelsuche-parent</artifactId>
    <version>0.5.3-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>regelsuche-quality</artifactId>
  <name>Regelsuche Quality Evidence</name>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jacoco</groupId>
      <artifactId>org.jacoco.report</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
            <regelsuche.maven.reactor>true</regelsuche.maven.reactor>
            <regelsuche.quality.outputDirectory>${project.build.directory}/reports/quality/jmh-history</regelsuche.quality.outputDirectory>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>verify-jmh-allocation-result</id>
      <activation><property><name>regelsuche.jmh.allocationResult</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-jmh-allocation</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.jmh.JmhAllocationMavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables combine.children="append">
                    <regelsuche.jmh.allocationSummary>${project.build.directory}/reports/quality/jmh-allocation/allocation.json</regelsuche.jmh.allocationSummary>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>verify-jmh-publication-result</id>
      <activation><property><name>regelsuche.jmh.publicationResult</name></property></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-retained-jmh-publication</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.jmh.JmhPublicationMavenEvidenceIT</test>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <systemPropertyVariables combine.children="append">
                    <regelsuche.jmh.publicationOutput>${project.build.directory}/reports/quality/jmh-publication</regelsuche.jmh.publicationOutput>
                  </systemPropertyVariables>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
