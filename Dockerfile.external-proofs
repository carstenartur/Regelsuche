FROM eclipse-temurin:25.0.5.1_2-jdk-noble@sha256:c7eef3dfeb81468533ea48c67bddaa8c7ca916454259e4d0d734d12bcff8e125 AS jdk
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
COPY --from=jdk /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="/proof/transport:/opt/lean/bin:${JAVA_HOME}/bin:${PATH}"
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git zstd gcc libc6-dev libgmp10 z3=4.8.12-3.1 cvc5=1.0.3-1 \
    && rm -rf /var/lib/apt/lists/*
# Use exactly the release URL, fallback asset and byte pin of the accepted proof workflow.
RUN test "$(dpkg --print-architecture)" = amd64 \
    && mkdir -p /opt/lean \
    && (curl -fsSL --retry 2 --max-time 240 'https://github.com/leanprover/lean4/releases/download/v4.19.0/lean-4.19.0-linux.tar.zst' -o /tmp/lean.tar.zst \
       || curl -fsSL --retry 2 --max-time 240 -H 'Accept: application/octet-stream' 'https://api.github.com/repos/leanprover/lean4/releases/assets/250981932' -o /tmp/lean.tar.zst) \
    && echo '6fe3ce97a58f44e2b3567d455b994eacec5bfe9ae7774f2a573444480ba813fe  /tmp/lean.tar.zst' | sha256sum --check \
    && tar --zstd -xf /tmp/lean.tar.zst -C /opt/lean --strip-components=1 --no-same-owner \
    && rm /tmp/lean.tar.zst && java -version && lean --version && z3 --version && cvc5 --version
WORKDIR /proof
CMD ["sleep", "infinity"]
