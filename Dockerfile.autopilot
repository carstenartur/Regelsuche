FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

COPY . .
RUN chmod +x ./gradlew \
    && ./gradlew --no-daemon :regelsuche-autopilot:installDist -x test

FROM eclipse-temurin:21-jre AS runtime

RUN useradd --create-home --uid 10001 regelsuche \
    && mkdir -p /output \
    && chown -R regelsuche:regelsuche /output

WORKDIR /opt/regelsuche
COPY --from=build \
    /workspace/regelsuche-autopilot/build/install/regelsuche-autopilot/ ./
RUN chown -R regelsuche:regelsuche /opt/regelsuche

ENV HOME=/tmp
USER regelsuche
VOLUME ["/output"]

ENTRYPOINT ["./bin/regelsuche-autopilot"]
CMD ["/output"]
