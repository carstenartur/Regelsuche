<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.regelsuche</groupId>
    <artifactId>regelsuche-parent</artifactId>
    <version>0.5.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>regelsuche-quality-aggregate</artifactId>
  <name>Regelsuche Maven Quality Aggregate</name>
  <description>
    Final reactor module for reports that require complete Surefire and
    Failsafe outputs.
  </description>

  <properties>
    <regelsuche.slow-test-report.full>false</regelsuche.slow-test-report.full>
    <regelsuche.slow-test-report.modules>
      regelsuche-core,
      regelsuche-egraph,
      regelsuche-search,
      regelsuche-validation,
      regelsuche-math-algorithms,
      regelsuche-math-jas,
      regelsuche-persistence,
      regelsuche-solver-ir,
      regelsuche-solver-portfolio,
      regelsuche-learning,
      regelsuche-discovery,
      regelsuche-discovery-sdk,
      regelsuche-plugin-api,
      regelsuche-extension-api,
      regelsuche-extension-runtime,
      regelsuche-experiments,
      regelsuche-cli,
      regelsuche-quality,
      maven-build-contract,
      regelsuche-persistence-hibernate,
      regelsuche-autopilot,
      regelsuche-release,
      regelsuche-benchmarks,
      app
    </regelsuche.slow-test-report.modules>
  </properties>

  <dependencies>
    <dependency>
      <groupId>de.regelsuche</groupId>
      <artifactId>regelsuche-quality</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>de.regelsuche</groupId>
      <artifactId>regelsuche-app</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>de.regelsuche</groupId>
      <artifactId>regelsuche-release</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-clean-plugin</artifactId>
        <executions>
          <execution>
            <id>delete-stale-qualified-release-evidence</id>
            <phase>initialize</phase>
            <goals><goal>clean</goal></goals>
            <configuration>
              <excludeDefaultDirectories>true</excludeDefaultDirectories>
              <filesets>
                <fileset>
                  <!-- Keep every output component inside the no-follow scan. -->
                  <directory>${maven.multiModuleProjectDirectory}</directory>
                  <includes>
                    <include>regelsuche-quality-aggregate/target/reports/release-readiness-qualified</include>
                    <include>regelsuche-quality-aggregate/target/reports/release-readiness-qualified/**</include>
                  </includes>
                  <followSymlinks>false</followSymlinks>
                </fileset>
              </filesets>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <regelsuche.repositoryRoot>${maven.multiModuleProjectDirectory}</regelsuche.repositoryRoot>
            <regelsuche.maven.reactor>true</regelsuche.maven.reactor>
            <regelsuche.slowTestReport.full>${regelsuche.slow-test-report.full}</regelsuche.slowTestReport.full>
            <regelsuche.slowTestReport.modules>${regelsuche.slow-test-report.modules}</regelsuche.slowTestReport.modules>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <!-- This decision uses current App production and the existing Java
               release authority; it is required by both verify lifecycles. -->
          <execution>
            <id>verify-qualified-release-readiness</id>
            <phase>verify</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <test>de.regelsuche.quality.aggregate.MavenQualifiedReleaseReadinessIT</test>
              <skip>false</skip>
              <skipTests>false</skipTests>
              <failIfNoTests>true</failIfNoTests>
              <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
              <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
            </configuration>
          </execution>
          <!-- This is a package-integrity gate, not a repeat of the test suite.
               The release workflow's -DskipTests package must still inspect
               the actual archives after the SNAPSHOT-to-release transition. -->
          <execution>
            <id>verify-distribution-archives</id>
            <phase>package</phase>
            <goals><goal>test</goal></goals>
            <configuration>
              <test>de.regelsuche.quality.aggregate.MavenDistributionArchiveAuditIT</test>
              <skip>false</skip>
              <skipTests>false</skipTests>
              <failIfNoTests>true</failIfNoTests>
              <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
              <systemPropertyVariables combine.children="append">
                <regelsuche.distributionVersion>${releaseVersion}</regelsuche.distributionVersion>
              </systemPropertyVariables>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>full</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <executions>
              <execution>
                <id>verify-installed-python-client</id>
                <phase>verify</phase>
                <goals><goal>test</goal></goals>
                <configuration>
                  <test>de.regelsuche.quality.aggregate.MavenPythonClientDistributionIT</test>
                  <skip>false</skip>
                  <skipTests>false</skipTests>
                  <failIfNoTests>true</failIfNoTests>
                  <failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
                  <forkedProcessTimeoutInSeconds>420</forkedProcessTimeoutInSeconds>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <regelsuche.slow-test-report.full>true</regelsuche.slow-test-report.full>
        <regelsuche.slow-test-report.modules>
          regelsuche-core,
          regelsuche-egraph,
          regelsuche-search,
          regelsuche-validation,
          regelsuche-math-algorithms,
          regelsuche-math-jas,
          regelsuche-persistence,
          regelsuche-solver-ir,
          regelsuche-solver-portfolio,
          regelsuche-learning,
          regelsuche-discovery,
          regelsuche-discovery-sdk,
          regelsuche-plugin-api,
          regelsuche-extension-api,
          regelsuche-extension-runtime,
          regelsuche-experiments,
          regelsuche-cli,
          regelsuche-quality,
          maven-build-contract,
          regelsuche-persistence-hibernate,
          regelsuche-autopilot,
          regelsuche-release,
          regelsuche-benchmarks,
          app,
          regelsuche-integration-tests
        </regelsuche.slow-test-report.modules>
      </properties>
      <dependencies>
        <dependency>
          <groupId>de.regelsuche</groupId>
          <artifactId>regelsuche-integration-tests</artifactId>
          <scope>test</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
