{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-candidate-independent-reusable-macro-batch-v1.schema.json",
  "title": "Candidate-independent reusable-macro canonical batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "benchmarkId", "challengeId", "repositoryRevision",
    "caseCorpusContentHash", "formationProfileId", "formationProfileContentHash",
    "freezeReceiptContentHash", "combinedPreregistrationHash", "adapterStatus",
    "configuredCampaigns", "executedCampaigns", "configuredPairedEvaluations",
    "executedPairedEvaluations", "macrosPerCampaign", "aggregateOutcomeCounts",
    "correctnessRegressionCount", "executedStates", "executedCandidateEvaluations",
    "formalProofStatus", "externalNoveltyStatus", "publicationAuthorized",
    "campaigns", "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.candidate-independent-reusable-macro-batch/v1"},
    "benchmarkId": {"const": "regelsuche-candidate-independent-autonomous-discovery-2026-07/v1"},
    "challengeId": {"const": "reusable-search-macros"},
    "repositoryRevision": {"type": "string", "minLength": 1},
    "caseCorpusContentHash": {"$ref": "#/$defs/hash"},
    "formationProfileId": {"const": "macro-primitives/v1"},
    "formationProfileContentHash": {"$ref": "#/$defs/hash"},
    "freezeReceiptContentHash": {"$ref": "#/$defs/hash"},
    "combinedPreregistrationHash": {"$ref": "#/$defs/hash"},
    "adapterStatus": {"const": "POST_FREEZE_TARGET_FREE_MACRO_FORMATION_AND_PAIRED_UTILITY"},
    "configuredCampaigns": {"const": 4},
    "executedCampaigns": {"const": 4},
    "configuredPairedEvaluations": {"const": 48},
    "executedPairedEvaluations": {"const": 48},
    "macrosPerCampaign": {"const": 3},
    "aggregateOutcomeCounts": {"$ref": "#/$defs/aggregateCounts"},
    "correctnessRegressionCount": {"const": 0},
    "executedStates": {"type": "integer", "minimum": 1},
    "executedCandidateEvaluations": {"type": "integer", "minimum": 1},
    "formalProofStatus": {"const": "NOT_EVALUATED"},
    "externalNoveltyStatus": {"const": "NOT_EVALUATED"},
    "publicationAuthorized": {"const": false},
    "campaigns": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/campaign"}
    },
    "contentHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "outcomeCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["IMPROVED", "REACHABILITY_GAIN", "NO_IMPROVEMENT", "NO_RESULT", "CORRECTNESS_REGRESSION", "CANDIDATE_NOT_FORMED"],
      "properties": {
        "IMPROVED": {"const": 2},
        "REACHABILITY_GAIN": {"const": 0},
        "NO_IMPROVEMENT": {"const": 6},
        "NO_RESULT": {"const": 4},
        "CORRECTNESS_REGRESSION": {"const": 0},
        "CANDIDATE_NOT_FORMED": {"const": 0}
      }
    },
    "aggregateCounts": {
      "type": "object", "additionalProperties": false,
      "required": ["IMPROVED", "REACHABILITY_GAIN", "NO_IMPROVEMENT", "NO_RESULT", "CORRECTNESS_REGRESSION", "CANDIDATE_NOT_FORMED"],
      "properties": {
        "IMPROVED": {"const": 8},
        "REACHABILITY_GAIN": {"const": 0},
        "NO_IMPROVEMENT": {"const": 24},
        "NO_RESULT": {"const": 16},
        "CORRECTNESS_REGRESSION": {"const": 0},
        "CANDIDATE_NOT_FORMED": {"const": 0}
      }
    },
    "campaign": {
      "type": "object", "additionalProperties": false,
      "required": ["campaignId", "challengeId", "configuredSeed", "status", "formationVisibility", "heldOutInputAccess", "formedMacroCount", "formation", "pairedEvaluations", "outcomeCounts", "resourceUse", "correctnessRegression", "formalProofStatus", "externalNoveltyStatus", "publicationEligible", "contentHash"],
      "properties": {
        "campaignId": {"type": "string", "pattern": "^reusable-search-macros-campaign-0[1-4]$"},
        "challengeId": {"const": "reusable-search-macros"},
        "configuredSeed": {"$ref": "#/$defs/hash"},
        "status": {"const": "POST_FREEZE_TARGET_FREE_MACRO_FORMATION_AND_PAIRED_UTILITY"},
        "formationVisibility": {"const": "TRAIN_ONLY"},
        "heldOutInputAccess": {"const": "EVALUATION_ONLY"},
        "formedMacroCount": {"const": 3},
        "formation": {"$ref": "#/$defs/formation"},
        "pairedEvaluations": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/evaluation"}},
        "outcomeCounts": {"$ref": "#/$defs/outcomeCounts"},
        "resourceUse": {"$ref": "#/$defs/resourceUse"},
        "correctnessRegression": {"const": false},
        "formalProofStatus": {"const": "NOT_EVALUATED"},
        "externalNoveltyStatus": {"const": "NOT_EVALUATED"},
        "publicationEligible": {"const": false},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "formation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "detail", "replayEvidence", "macros", "contentHash"],
      "properties": {
        "status": {"const": "SELECTED"},
        "detail": {"type": "string", "minLength": 1},
        "replayEvidence": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/replayEvidence"}},
        "macros": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/macro"}},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "replayEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["traceId", "reproduced", "exploredStates", "actualRuleIds", "assignedOperationIds", "compressedOperationIds", "expressionPath", "detail", "contentHash"],
      "properties": {
        "traceId": {"type": "string", "pattern": "^case-(13|14)-trace-[12]$"},
        "reproduced": {"const": true},
        "exploredStates": {"type": "integer", "minimum": 1},
        "actualRuleIds": {"$ref": "#/$defs/stringArray"},
        "assignedOperationIds": {"$ref": "#/$defs/stringArray"},
        "compressedOperationIds": {"$ref": "#/$defs/stringArray"},
        "expressionPath": {"$ref": "#/$defs/stringArray"},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "macro": {
      "type": "object", "additionalProperties": false,
      "required": ["macroId", "operationSequence", "supportingTraceIds", "leftPattern", "rightPattern", "parameterRelations", "assumptions", "proofStatus", "knownRuleStatus", "supportingExamples", "occurrenceCount", "confidenceScore", "canonicalHash", "validationEvidence", "atomicSteps", "contentHash"],
      "properties": {
        "macroId": {"type": "string", "pattern": "^macro_candidate_independent_[0-9a-f]+$"},
        "operationSequence": {"$ref": "#/$defs/stringArray"},
        "supportingTraceIds": {"$ref": "#/$defs/stringArray"},
        "leftPattern": {"type": "string", "minLength": 1},
        "rightPattern": {"type": "string", "minLength": 1},
        "parameterRelations": {"$ref": "#/$defs/stringArray"},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "proofStatus": {"const": "SYMBOLICALLY_VERIFIED"},
        "knownRuleStatus": {"type": "string", "minLength": 1},
        "supportingExamples": {"type": "integer", "minimum": 1},
        "occurrenceCount": {"type": "integer", "minimum": 1},
        "confidenceScore": {"const": 1.0},
        "canonicalHash": {"type": "string", "minLength": 1},
        "validationEvidence": {"type": "string", "minLength": 1},
        "atomicSteps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/atomicStep"}},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "atomicStep": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "beforeExpression", "afterExpression", "ruleId", "ruleKind", "scoreBefore", "scoreAfter", "equivalencePreserving", "explanation", "assumptions", "contentHash"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "beforeExpression": {"type": "string"},
        "afterExpression": {"type": "string"},
        "ruleId": {"type": "string", "minLength": 1},
        "ruleKind": {"type": "string", "enum": ["SIMPLIFY", "NORMALIZE", "EXPAND", "FACTOR"]},
        "scoreBefore": {"type": "integer"},
        "scoreAfter": {"type": "integer"},
        "equivalencePreserving": {"const": true},
        "explanation": {"type": "string"},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["caseId", "split", "structuralCluster", "caseContentHash", "taskId", "source", "target", "assumptions", "searchBudget", "outcome", "baseline", "macroEnabled", "correctnessRegression", "detail", "contentHash"],
      "properties": {
        "caseId": {"type": "string", "pattern": "^case-(1[3-8])$"},
        "split": {"enum": ["TRAIN", "VALIDATION", "TEST"]},
        "structuralCluster": {"type": "string", "minLength": 1},
        "caseContentHash": {"$ref": "#/$defs/hash"},
        "taskId": {"type": "string", "pattern": "^case-(1[3-8])-task-[12]$"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "searchBudget": {"$ref": "#/$defs/taskBudget"},
        "outcome": {"enum": ["IMPROVED", "REACHABILITY_GAIN", "NO_IMPROVEMENT", "NO_RESULT", "CORRECTNESS_REGRESSION", "CANDIDATE_NOT_FORMED"]},
        "baseline": {"$ref": "#/$defs/searchRun"},
        "macroEnabled": {"$ref": "#/$defs/searchRun"},
        "correctnessRegression": {"const": false},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "taskBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["maxDepth", "maxExpandedStates"],
      "properties": {
        "maxDepth": {"type": "integer", "minimum": 0},
        "maxExpandedStates": {"type": "integer", "minimum": 1}
      }
    },
    "searchRun": {
      "type": "object", "additionalProperties": false,
      "required": ["success", "reachedExpression", "path", "ruleIds", "expandedStates", "generatedCandidates", "budgetExhausted", "detail", "contentHash"],
      "properties": {
        "success": {"type": "boolean"},
        "reachedExpression": {"type": "string"},
        "path": {"$ref": "#/$defs/stringArray"},
        "ruleIds": {"$ref": "#/$defs/stringArray"},
        "expandedStates": {"type": "integer", "minimum": 0},
        "generatedCandidates": {"type": "integer", "minimum": 0},
        "budgetExhausted": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "resourceUse": {
      "type": "object", "additionalProperties": false,
      "required": ["configuredStates", "executedStates", "remainingStates", "configuredCandidateEvaluations", "executedCandidateEvaluations", "remainingCandidateEvaluations", "configuredProofAttempts", "executedProofAttempts", "remainingProofAttempts", "formationStates", "formationCandidateEvaluations", "pairedSearchStates", "pairedSearchCandidateEvaluations"],
      "properties": {
        "configuredStates": {"const": 3000},
        "executedStates": {"type": "integer", "minimum": 1, "maximum": 3000},
        "remainingStates": {"type": "integer", "minimum": 0, "maximum": 2999},
        "configuredCandidateEvaluations": {"const": 600},
        "executedCandidateEvaluations": {"type": "integer", "minimum": 1, "maximum": 600},
        "remainingCandidateEvaluations": {"type": "integer", "minimum": 0, "maximum": 599},
        "configuredProofAttempts": {"const": 100},
        "executedProofAttempts": {"const": 0},
        "remainingProofAttempts": {"const": 100},
        "formationStates": {"type": "integer", "minimum": 1},
        "formationCandidateEvaluations": {"type": "integer", "minimum": 1},
        "pairedSearchStates": {"type": "integer", "minimum": 1},
        "pairedSearchCandidateEvaluations": {"type": "integer", "minimum": 1}
      }
    }
  }
}
