{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-train-suite-v1.schema.json",
  "title": "Regelsuche rewrite-program TRAIN suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suiteId",
    "evaluationSplit",
    "evaluatorProfile",
    "cases",
    "heuristic",
    "primitiveWorkBudget",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-train-suite/v1"
    },
    "suiteId": {
      "$ref": "#/$defs/id"
    },
    "evaluationSplit": {
      "const": "TRAIN"
    },
    "evaluatorProfile": {
      "const": "EXACT_RATIONAL_NORMAL_FORM_WITH_DECLARED_ASSUMPTIONS"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "heuristic": {
      "$ref": "#/$defs/heuristic"
    },
    "primitiveWorkBudget": {
      "$ref": "#/$defs/primitiveWorkBudget"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "familyId",
        "inputExpression",
        "targetExpression",
        "assumptions"
      ],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/id"
        },
        "familyId": {
          "$ref": "#/$defs/id"
        },
        "inputExpression": {
          "$ref": "#/$defs/text"
        },
        "targetExpression": {
          "$ref": "#/$defs/text"
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    },
    "heuristic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDepth",
        "maxVisitedExpressions",
        "significantImprovementThreshold",
        "maxExpandingSteps",
        "maxCandidatesPerState",
        "beamWidth"
      ],
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxVisitedExpressions": {
          "type": "integer",
          "minimum": 1
        },
        "significantImprovementThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "maxExpandingSteps": {
          "type": "integer",
          "minimum": 0
        },
        "maxCandidatesPerState": {
          "type": "integer",
          "minimum": 1
        },
        "beamWidth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "primitiveWorkBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPrimitiveSteps",
        "maxExploredStates",
        "maxCandidatesPerState",
        "maxExpandingSteps",
        "maxWorkUnits"
      ],
      "properties": {
        "maxPrimitiveSteps": {
          "type": "integer",
          "minimum": 1
        },
        "maxExploredStates": {
          "type": "integer",
          "minimum": 1
        },
        "maxCandidatesPerState": {
          "type": "integer",
          "minimum": 1
        },
        "maxExpandingSteps": {
          "type": "integer",
          "minimum": 0
        },
        "maxWorkUnits": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
