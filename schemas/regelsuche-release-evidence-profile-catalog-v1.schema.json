{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.release-evidence-profile-catalog/v1",
  "title": "Regelsuche 0.2 release evidence profile catalog",
  "type": "object",
  "required": [
    "schema", "profiles", "autonomyClaimProfile", "externalNoveltyProfile"
  ],
  "properties": {
    "schema": { "const": "regelsuche.release-evidence-profile-catalog/v1" },
    "profiles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "profile", "claim", "authorizesAutonomyClaim", "requirements"
        ],
        "properties": {
          "profile": {
            "enum": [
              "SEARCH_REPRODUCIBILITY",
              "HIDDEN_RULE_REDISCOVERY",
              "OPEN_TARGET_DISCOVERY",
              "AUTONOMOUS_CAMPAIGN",
              "EXTERNAL_NOVELTY_REVIEW"
            ]
          },
          "claim": { "$ref": "#/$defs/nonBlank" },
          "authorizesAutonomyClaim": { "type": "boolean" },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonBlank" }
          }
        },
        "additionalProperties": false
      }
    },
    "autonomyClaimProfile": { "const": "AUTONOMOUS_CAMPAIGN" },
    "externalNoveltyProfile": { "const": "EXTERNAL_NOVELTY_REVIEW" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
