{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.proof-carrying-showcase-candidate-freeze/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "showcaseId",
    "planContentHash",
    "repositoryCommit",
    "trainingRunHash",
    "selectionEvidenceHash",
    "candidateContentHash",
    "candidateAlphaStructuralHash",
    "humanReadableProgramHash",
    "primitiveInventoryHash",
    "workBudgetPolicyHash",
    "evaluationProtocolHash",
    "seedCandidateHashes",
    "programNodeCount",
    "containsCompositionTopology",
    "containsDecisionTopology",
    "minimumDeclaredPrimitivePathSteps",
    "frozenAtUnixTime",
    "randomnessNotBeforeUnixTime",
    "status",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.proof-carrying-showcase-candidate-freeze/v1"
    },
    "showcaseId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "planContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "repositoryCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "trainingRunHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selectionEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateAlphaStructuralHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "humanReadableProgramHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "primitiveInventoryHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "workBudgetPolicyHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evaluationProtocolHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "seedCandidateHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "programNodeCount": {
      "type": "integer",
      "minimum": 1
    },
    "containsCompositionTopology": {
      "const": true
    },
    "containsDecisionTopology": {
      "const": true
    },
    "minimumDeclaredPrimitivePathSteps": {
      "type": "integer",
      "minimum": 3
    },
    "frozenAtUnixTime": {
      "type": "integer",
      "minimum": 1
    },
    "randomnessNotBeforeUnixTime": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "const": "CANDIDATE_FROZEN_FINAL_TEST_UNSEEN"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
