{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-distribution-operation-result/v1",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "operationId",
    "outcome",
    "decision",
    "installation",
    "localEvidenceStatus"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-distribution-operation-result/v1"
    },
    "scope": {
      "$ref": "regelsuche-plugin-checkpoint-operation-v1.schema.json#/$defs/scope"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "outcome": {
      "enum": [
        "COMMITTED",
        "REJECTED",
        "OUTCOME_UNKNOWN"
      ]
    },
    "decision": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "operation",
            "outcome"
          ],
          "properties": {
            "operation": {
              "$ref": "regelsuche-plugin-checkpoint-operation-v1.schema.json"
            },
            "outcome": {
              "enum": [
                "COMMITTED",
                "REJECTED",
                "OUTCOME_UNKNOWN"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "installation": {
      "anyOf": [
        {
          "$ref": "regelsuche-plugin-installation-v1.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "localEvidenceStatus": {
      "enum": [
        "AVAILABLE",
        "MISSING_OR_INVALID",
        "NOT_CONFIRMED"
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "COMMITTED"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "type": "object",
            "required": [
              "operation",
              "outcome"
            ],
            "properties": {
              "operation": {
                "$ref": "regelsuche-plugin-checkpoint-operation-v1.schema.json"
              },
              "outcome": {
                "enum": [
                  "COMMITTED",
                  "REJECTED",
                  "OUTCOME_UNKNOWN"
                ]
              }
            },
            "additionalProperties": false
          },
          "localEvidenceStatus": {
            "enum": [
              "AVAILABLE",
              "MISSING_OR_INVALID"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "installation": {
            "type": "null"
          },
          "localEvidenceStatus": {
            "const": "NOT_CONFIRMED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "localEvidenceStatus": {
            "const": "AVAILABLE"
          }
        }
      },
      "then": {
        "properties": {
          "installation": {
            "$ref": "regelsuche-plugin-installation-v1.schema.json"
          }
        }
      },
      "else": {
        "properties": {
          "installation": {
            "type": "null"
          }
        }
      }
    }
  ]
}
