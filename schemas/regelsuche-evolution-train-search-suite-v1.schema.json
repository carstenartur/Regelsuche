{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-evolution-train-search-suite-v1.schema.json",
  "title": "Regelsuche evolution TRAIN search suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suiteId",
    "cases",
    "heuristic",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-train-search-suite/v1"
    },
    "suiteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "familyId",
          "inputExpression",
          "targetExpression"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,127}$"
          },
          "familyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,127}$"
          },
          "inputExpression": {
            "type": "string",
            "minLength": 1
          },
          "targetExpression": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "heuristic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxDepth",
        "maxVisitedExpressions",
        "significantImprovementThreshold",
        "maxExpandingSteps",
        "maxCandidatesPerState",
        "beamWidth"
      ],
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxVisitedExpressions": {
          "type": "integer",
          "minimum": 1
        },
        "significantImprovementThreshold": {
          "type": "integer",
          "minimum": 1
        },
        "maxExpandingSteps": {
          "type": "integer",
          "minimum": 0
        },
        "maxCandidatesPerState": {
          "type": "integer",
          "minimum": 1
        },
        "beamWidth": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
