{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.solver-execution/v1",
  "title": "Regelsuche atomic solver execution v1",
  "type": "object",
  "required": [
    "schema", "obligationHash", "translationHash", "resultHash",
    "backendId", "backendVersion", "translationStatus",
    "resultStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.solver-execution/v1" },
    "obligationHash": { "$ref": "#/$defs/sha256" },
    "translationHash": { "$ref": "#/$defs/sha256" },
    "resultHash": { "$ref": "#/$defs/sha256" },
    "backendId": { "$ref": "#/$defs/nonBlank" },
    "backendVersion": { "$ref": "#/$defs/nonBlank" },
    "translationStatus": {
      "enum": ["LOSSLESS", "APPROXIMATED", "REJECTED"]
    },
    "resultStatus": {
      "enum": [
        "CONFIRMED", "REFUTED", "UNKNOWN", "TIMEOUT",
        "UNSUPPORTED", "ERROR"
      ]
    },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
