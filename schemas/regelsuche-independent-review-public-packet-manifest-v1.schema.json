{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-independent-review-public-packet-manifest-v1.schema.json",
  "title": "Regelsuche public blinded-packet manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","studyPlanHash","reviewerInstructionsHash","packetCount","packets","reviewCollectionStatus","empiricalConsensusStatus","contentHash"],
  "properties": {
    "schema": {"const": "regelsuche.independent-review-public-packet-manifest/v1"},
    "studyPlanHash": {"$ref": "#/$defs/sha256"},
    "reviewerInstructionsHash": {"$ref": "#/$defs/sha256"},
    "packetCount": {"type": "integer", "minimum": 1},
    "packets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/packetReference"}},
    "reviewCollectionStatus": {"const": "NOT_COLLECTED"},
    "empiricalConsensusStatus": {"const": "NOT_EVALUATED"},
    "contentHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "packetReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packetId","packetContentHash"],
      "properties": {
        "packetId": {"type": "string", "pattern": "^packet-[0-9a-f]{24}$"},
        "packetContentHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
