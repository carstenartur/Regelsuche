{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-trust-store-chain-checkpoint/v1",
  "title": "Regelsuche plugin trust-store chain checkpoint v1",
  "type": "object",
  "required": [
    "schema",
    "trustDomainId",
    "sequence",
    "revisionHash",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-trust-store-chain-checkpoint/v1"
    },
    "trustDomainId": {
      "$ref": "#/$defs/identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "revisionHash": {
      "$ref": "#/$defs/sha256"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
