FROM eclipse-temurin:25.0.4_7-jdk-noble@sha256:534968c051301957beae735e7ba1db54d99ddecf08746d3b9d4f318cc132dbc3 AS build
WORKDIR /workspace

COPY . .
RUN chmod +x ./gradlew \
    && ./gradlew --no-daemon --no-configuration-cache \
        :regelsuche-discovery:classes --console=plain

FROM build AS target-free-held-out-reproduction
ARG REGELSUCHE_REPOSITORY_REVISION
ENV REGELSUCHE_AUTHORITY_GITHUB_SHA=${REGELSUCHE_REPOSITORY_REVISION} \
    GRADLE_USER_HOME=/home/reproducer/.gradle \
    HOME=/home/reproducer

RUN useradd --create-home --uid 10001 reproducer \
    && mkdir -p /out \
    && cp -a /root/.gradle /home/reproducer/.gradle \
    && find /home/reproducer/.gradle -type f -name '*.lock' -delete \
    && chown -R reproducer:reproducer /workspace /out /home/reproducer

USER reproducer
VOLUME ["/out"]
ENTRYPOINT ["./gradlew", "--no-daemon", "--no-configuration-cache", "--offline", ":regelsuche-discovery:generateTargetFreeHeldOutMatrix", "-PtargetFreeHeldOutOutput=/out", "--rerun-tasks", "--console=plain"]
