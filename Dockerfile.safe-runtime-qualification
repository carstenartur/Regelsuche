FROM eclipse-temurin:25.0.3_9-jdk-noble@sha256:3eb81ed94d8c1a34422f19f8188548bdf02cae69c91d0328afdbb7abed90f617 AS build
WORKDIR /workspace
ARG REGELSUCHE_REPOSITORY_REVISION
ENV REGELSUCHE_AUTHORITY_GITHUB_SHA=${REGELSUCHE_REPOSITORY_REVISION}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        python3 \
        python3-venv \
    && rm -rf /var/lib/apt/lists/*

COPY . .
RUN test "${#REGELSUCHE_REPOSITORY_REVISION}" -eq 40 \
    && ! printf '%s' "${REGELSUCHE_REPOSITORY_REVISION}" | grep -q '[^0-9a-f]' \
    && chmod +x ./gradlew \
    && ./gradlew --no-daemon --no-configuration-cache --no-build-cache --max-workers=2 \
        -PregelsucheRepositoryRevision="${REGELSUCHE_REPOSITORY_REVISION}" \
        prepareVerificationEnvironment \
        :app:installDist \
        :regelsuche-learning:exportSafeRuntimeProductQualificationInputs \
        verifySafeRuntimeProductQualificationInputs \
        --console=plain

FROM build AS safe-runtime-product-qualification
ARG REGELSUCHE_REPOSITORY_REVISION
ENV REGELSUCHE_REPOSITORY_REVISION=${REGELSUCHE_REPOSITORY_REVISION} \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/home/reproducer

RUN useradd --create-home --uid 10001 reproducer \
    && mkdir -p /out \
    && chown -R reproducer:reproducer /workspace /out /home/reproducer

USER reproducer
VOLUME ["/out"]
ENTRYPOINT ["/bin/bash", "-lc", "set -euo pipefail; build/verification-venv/bin/python -B scripts/safe_runtime_qualification/run.py --app-home app/build/install/app --inputs build/reports/safe-runtime-product-qualification/inputs --manifest config/qualification/safe-runtime-public-v1.json --revision \"${REGELSUCHE_REPOSITORY_REVISION}\" --output /out; build/verification-venv/bin/python -B scripts/safe_runtime_qualification/verify.py --root /out --manifest config/qualification/safe-runtime-public-v1.json --schema docs/schemas/regelsuche-safe-runtime-product-qualification-v1.schema.json --app-home app/build/install/app --inputs build/reports/safe-runtime-product-qualification/inputs --revision \"${REGELSUCHE_REPOSITORY_REVISION}\""]
