  "components": {
    "parameters": {
      "PathId": {"name": "pathId", "in": "path", "required": true, "description": "Stabile ID eines gefundenen Rechenwegs", "schema": {"type": "string"}},
      "IdentityId": {"name": "identityId", "in": "path", "required": true, "schema": {"type": "string"}},
      "DemoId": {"name": "demoId", "in": "path", "required": true, "schema": {"type": "string"}},
      "JobId": {"name": "jobId", "in": "path", "required": true, "schema": {"type": "string"}}
    },
    "responses": {
      "BadRequest": {
        "description": "Ungültige, unvollständige oder syntaktisch mehrdeutige Eingabe",
        "content": {
          "text/plain": {"schema": {"type": "string"}},
          "application/json": {"schema": {"$ref": "#/components/schemas/ErrorResponse"}}
        }
      },
      "NotFound": {"description": "Ressource wurde nicht gefunden", "content": {"text/plain": {"schema": {"type": "string"}}}},
      "Conflict": {"description": "Der angeforderte Zustand ist veraltet oder nicht mehr anwendbar", "content": {"text/plain": {"schema": {"type": "string"}}}},
      "MethodNotAllowed": {"description": "HTTP-Methode wird für diese Operation nicht unterstützt"},
      "PayloadTooLarge": {
        "description": "Der JSON-Request-Body überschreitet das konfigurierte Byte-Limit",
        "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PayloadTooLargeError"}}}
      },
      "Unavailable": {"description": "Funktion ist in der aktuellen Konfiguration deaktiviert oder nicht verfügbar"}
    },
    "schemas": {
      "JsonObject": {"type": "object", "additionalProperties": true},
      "ErrorResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "code", "message"],
        "properties": {
          "error": {"type": "boolean", "const": true},
          "code": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1}
        }
      },
      "PayloadTooLargeError": {
        "type": "object",
        "additionalProperties": false,
        "required": ["error", "code", "message", "limitBytes"],
        "properties": {
          "error": {"type": "boolean", "const": true},
          "code": {"type": "string", "const": "PAYLOAD_TOO_LARGE"},
          "message": {"type": "string", "const": "request body exceeds configured limit"},
          "limitBytes": {"type": "integer", "minimum": 1}
        }
      },
      "SearchRequest": {
        "type": "object",
        "required": ["expression"],
        "properties": {
          "expression": {"type": "string"},
          "type": {"type": "string", "enum": ["TERM", "EQUATION"], "default": "TERM"},
          "profile": {"type": "string", "default": "FAST_SIMPLIFY"},
          "goal": {"type": "string", "enum": ["SIMPLIFY", "FACTORIZE", "TEACHING_FRIENDLY", "PROOF_FRIENDLY", "NUMERICALLY_STABLE"]}
        }
      },
      "SearchResult": {
        "type": "object",
        "required": ["profile", "goal", "inputType", "expression", "successes"],
        "properties": {
          "profile": {"type": "string"},
          "goal": {"type": "string"},
          "inputType": {"type": "string"},
          "expression": {"type": "string"},
          "successes": {"type": "integer", "minimum": 0},
          "bestExpression": {"type": ["string", "null"]},
          "improvement": {"type": "integer"}
        }
      },
      "DiscoveryRequest": {"type": "object", "properties": {"min": {"type": "integer", "default": 1}, "max": {"type": "integer", "default": 3}}},
      "ProofRequest": {
        "type": "object",
        "required": ["leftPattern", "rightPattern"],
        "properties": {
          "leftPattern": {"type": "string"},
          "rightPattern": {"type": "string"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "backend": {"type": "string", "enum": ["lean", "smt"]}
        }
      },
      "ProofJobRequest": {
        "type": "object",
        "required": ["leftPattern", "rightPattern"],
        "properties": {
          "leftPattern": {"type": "string"},
          "rightPattern": {"type": "string"},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "priority": {"type": "integer", "default": 0}
        }
      },
      "DidacticStepRequest": {
        "type": "object",
        "required": ["currentExpression", "studentStep"],
        "properties": {
          "currentExpression": {"type": "string"},
          "studentStep": {"type": "string"},
          "difficulty": {"type": "string", "default": "MITTELSTUFE"}
        }
      },
      "InspectApplyRequest": {
        "type": "object",
        "required": ["expression", "pathKey"],
        "anyOf": [{"required": ["matchId"]}, {"required": ["matchIndex"]}],
        "properties": {
          "expression": {"type": "string"},
          "pathKey": {"type": "string"},
          "matchId": {"type": "string"},
          "matchIndex": {"type": "integer", "minimum": 0}
        }
      },
      "RuleRadarContext": {
        "type": "object",
        "properties": {
          "knowledgeProfile": {"type": "string", "default": "CORE"},
          "includePlugins": {"type": "boolean", "default": true},
          "includeLearnedMacros": {"type": "boolean", "default": true},
          "minMacroProofStatus": {"type": "string", "default": "VALIDATED_BY_EXAMPLES"},
          "goalExpression": {"type": "string"},
          "maxCandidatesPerPosition": {"type": "integer", "minimum": 1, "maximum": 200, "default": 24},
          "maxCandidatesTotal": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 240},
          "assumptions": {"type": "array", "items": {"type": "string"}},
          "includeRejectedCandidates": {"type": "boolean", "default": true}
        }
      },
      "RuleRadarRequest": {
        "type": "object",
        "required": ["expression"],
        "properties": {"expression": {"type": "string"}, "context": {"$ref": "#/components/schemas/RuleRadarContext"}}
      },
      "RuleRadarApplyRequest": {
        "type": "object",
        "required": ["expression", "candidateId"],
        "properties": {"expression": {"type": "string"}, "candidateId": {"type": "string"}, "context": {"$ref": "#/components/schemas/RuleRadarContext"}}
      },
      "RuleRadarSearchRequest": {
        "type": "object",
        "required": ["expression"],
        "properties": {
          "expression": {"type": "string"},
          "targetExpression": {"type": "string"},
          "maxDepth": {"type": "integer", "minimum": 1, "maximum": 12, "default": 4},
          "maxStates": {"type": "integer", "minimum": 1, "maximum": 2000, "default": 120},
          "maxMovesPerState": {"type": "integer", "minimum": 1, "maximum": 500, "default": 60},
          "context": {"$ref": "#/components/schemas/RuleRadarContext"}
        }
      }
    }
  }
}
