{
  "openapi": "3.1.0",
  "info": {
    "title": "Regelsuche REST API",
    "version": "0.2.0",
    "description": "Verbindliche technische Referenz der eingebetteten Regelsuche-Web-Workbench. Die nutzerseitige Dokumentation beschreibt die grafischen Abläufe; Methoden, Pfade, Schemata und Statuscodes werden hier gepflegt."
  },
  "servers": [
    {"url": "/", "description": "Aktuelle lokale Workbench-Instanz"}
  ],
  "tags": [
    {"name": "Search", "description": "Mathematische Suche und Discovery starten."},
    {"name": "Paths", "description": "Gefundene Rechenwege, Replay und Vergleich."},
    {"name": "Search Graph", "description": "Roher und semantisch aufbereiteter Suchgraph."},
    {"name": "Identities", "description": "Emergente Identitäten und Promotion."},
    {"name": "Candidates", "description": "Geminte Regelkandidaten."},
    {"name": "Inventory", "description": "Wiederverwendbare Regeln und Import."},
    {"name": "Exports", "description": "Berichte, Graphen und Artefakt-Bundles."},
    {"name": "Analysis", "description": "Erklärung und Bewertung einzelner Suchzüge."},
    {"name": "Demos", "description": "Kuratierte reproduzierbare Produktdemos."},
    {"name": "Plugins", "description": "Geladene Plugins, Regeln und Profile."},
    {"name": "Memory", "description": "Suchgedächtnis, Pruning und universelle Muster."},
    {"name": "Proof", "description": "Proof-Status und synchroner Proof-Bridge-Aufruf."},
    {"name": "Proof Jobs", "description": "Persistente asynchrone Beweisaufträge und Artefakte."},
    {"name": "Benchmark", "description": "Reproduzierbare Qualitätsszenarien."},
    {"name": "Didactics", "description": "Schrittprüfung, Hinweise, Replay, Analytics und Exporte."},
    {"name": "Rule Inspection", "description": "Baumlokale Regelinspektion und Anwendung."},
    {"name": "Rule Radar", "description": "Positionsgebundene AST-Kandidaten, Anwendung und begrenzte Suche."}
  ],
  "paths": {
    "/api/search": {
      "post": {
        "tags": ["Search"],
        "operationId": "startSearch",
        "summary": "Mathematische Suche starten",
        "description": "Startet eine Suche für Ausdruck, Eingabetyp, Profil und optionales Transformationsziel.",
        "x-regelsuche-context": "/api/search",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchRequest"}}}},
        "responses": {
          "200": {"description": "Suchzusammenfassung", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SearchResult"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "413": {"$ref": "#/components/responses/PayloadTooLarge"}
        }
      }
    },
    "/api/discover": {
      "post": {
        "tags": ["Search"],
        "operationId": "discoverRules",
        "summary": "Begrenzte Rule-Discovery ausführen",
        "x-regelsuche-context": "/api/discover",
        "requestBody": {"required": false, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiscoveryRequest"}}}},
        "responses": {
          "200": {"description": "Anzahl gefundener Kandidaten und Transformationen", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "405": {"$ref": "#/components/responses/MethodNotAllowed"},
          "413": {"$ref": "#/components/responses/PayloadTooLarge"}
        }
      }
    },
    "/api/paths": {
      "get": {
        "tags": ["Paths"],
        "operationId": "listPaths",
        "summary": "Gefundene Rechenwege auflisten",
        "x-regelsuche-context": "/api/paths",
        "parameters": [
          {"name": "sort", "in": "query", "required": false, "description": "score, length, teaching oder proof", "schema": {"type": "string", "default": "score"}},
          {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0}}
        ],
        "responses": {"200": {"description": "Sortierte Pfadliste", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/paths/compare": {
      "get": {
        "tags": ["Paths"],
        "operationId": "comparePaths",
        "summary": "Zwei Rechenwege vergleichen",
        "x-regelsuche-context": "/api/paths",
        "parameters": [
          {"name": "left", "in": "query", "required": true, "schema": {"type": "string"}},
          {"name": "right", "in": "query", "required": true, "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "Vergleich von Regeln, Schritten, Scores und Annahmen", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/paths/{pathId}": {
      "get": {
        "tags": ["Paths"],
        "operationId": "getPath",
        "summary": "Einzelnen Rechenweg laden",
        "x-regelsuche-context": "/api/paths",
        "parameters": [{"$ref": "#/components/parameters/PathId"}],
        "responses": {
          "200": {"description": "Rechenweg", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/paths/{pathId}/replay": {
      "get": {
        "tags": ["Paths"],
        "operationId": "replayPath",
        "summary": "Schrittweises Replay eines Rechenwegs laden",
        "x-regelsuche-context": "/api/paths",
        "parameters": [{"$ref": "#/components/parameters/PathId"}],
        "responses": {
          "200": {"description": "Replay mit mathematischen Layout- und Diff-Informationen", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/graph": {
      "get": {
        "tags": ["Search Graph"],
        "operationId": "getMermaidGraph",
        "summary": "Mermaid-Graph aller Pfade laden",
        "x-regelsuche-context": "/api/graph",
        "responses": {"200": {"description": "Mermaid-Quelltext", "content": {"text/plain": {"schema": {"type": "string"}}}}}
      }
    },
    "/api/graph/{pathId}": {
      "get": {
        "tags": ["Search Graph"],
        "operationId": "getPathMermaidGraph",
        "summary": "Mermaid-Graph eines einzelnen Pfads laden",
        "x-regelsuche-context": "/api/graph",
        "parameters": [{"$ref": "#/components/parameters/PathId"}],
        "responses": {"200": {"description": "Mermaid-Quelltext", "content": {"text/plain": {"schema": {"type": "string"}}}}}
      }
    },
    "/api/search-graph": {
      "get": {
        "tags": ["Search Graph"],
        "operationId": "getSearchGraph",
        "summary": "Strukturierten Suchgraph laden",
        "x-regelsuche-context": "/api/search-graph",
        "parameters": [{"name": "filter", "in": "query", "required": false, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Suchgraph-DTO", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/search-graph/semantic": {
      "get": {
        "tags": ["Search Graph"],
        "operationId": "getSemanticSearchGraph",
        "summary": "Semantisch aufbereiteten Suchgraph laden",
        "x-regelsuche-context": "/api/search-graph/semantic",
        "parameters": [
          {"name": "mode", "in": "query", "required": false, "schema": {"type": "string", "default": "semantic"}},
          {"name": "showMacroSteps", "in": "query", "required": false, "schema": {"type": "string", "default": "compact"}},
          {"name": "showLowSignal", "in": "query", "required": false, "schema": {"type": "boolean", "default": false}},
          {"name": "showAlternatives", "in": "query", "required": false, "schema": {"type": "boolean", "default": true}},
          {"name": "showVariants", "in": "query", "required": false, "schema": {"type": "boolean", "default": false}},
          {"name": "pathId", "in": "query", "required": false, "schema": {"type": "string"}}
        ],
        "responses": {"200": {"description": "Semantischer Suchgraph", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/identities": {
      "get": {
        "tags": ["Identities"],
        "operationId": "listIdentities",
        "summary": "Emergente Identitäten auflisten",
        "x-regelsuche-context": "/api/identities",
        "responses": {"200": {"description": "Identitätskarten mit Evidenz und Status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/identities/{identityId}/promote": {
      "post": {
        "tags": ["Identities"],
        "operationId": "promoteIdentity",
        "summary": "Identität als wiederverwendbare Regel übernehmen",
        "x-regelsuche-context": "/api/identities",
        "parameters": [{"$ref": "#/components/parameters/IdentityId"}],
        "responses": {
          "200": {"description": "Promovierte Regel-ID und Domäne", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/candidates": {
      "get": {
        "tags": ["Candidates"],
        "operationId": "listCandidates",
        "summary": "Regelkandidaten auflisten",
        "x-regelsuche-context": "/api/candidates",
        "responses": {"200": {"description": "Kandidaten mit Score, Status und Proof-Status", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/inventory": {
      "get": {
        "tags": ["Inventory"],
        "operationId": "listInventoryRules",
        "summary": "Wiederverwendbare Regeln auflisten",
        "x-regelsuche-context": "/api/inventory",
        "responses": {"200": {"description": "Regelinventar", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      },
      "post": {
        "tags": ["Inventory"],
        "operationId": "importInventoryBundle",
        "summary": "Export-Bundle in das Inventar importieren",
        "x-regelsuche-context": "/api/inventory",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["json"], "properties": {"json": {"type": "string"}}}}}},
        "responses": {
          "200": {"description": "Anzahl importierter Regeln", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "413": {"$ref": "#/components/responses/PayloadTooLarge"}
        }
      }
    },
    "/api/exports": {
      "get": {
        "tags": ["Exports"],
        "operationId": "getExportBundleJson",
        "summary": "Komplettes Export-Bundle als JSON laden",
        "x-regelsuche-context": "/api/exports",
        "responses": {"200": {"description": "Export-Bundle", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/exports/{format}": {
      "get": {
        "tags": ["Exports"],
        "operationId": "downloadExport",
        "summary": "Bericht oder Graph in einem unterstützten Format laden",
        "description": "Unterstützt unter anderem markdown, latex, mermaid, json, search-graph.json, search-graph.mmd, search-graph.graphml, best-path.md, identity-report.tex und bundle.zip. Spezifische Unterressourcen werden ebenfalls unter diesem Kontext ausgeliefert.",
        "x-regelsuche-context": "/api/exports",
        "parameters": [{"name": "format", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Exportinhalt im formatspezifischen Medientyp"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/exports/cluster/{clusterId}.md": {
      "get": {
        "tags": ["Exports"],
        "operationId": "downloadClusterMarkdown",
        "summary": "Suchgraph-Cluster als Markdown laden",
        "x-regelsuche-context": "/api/exports",
        "parameters": [{"name": "clusterId", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Markdown-Darstellung des Clusters", "content": {"text/plain": {"schema": {"type": "string"}}}}}
      }
    },
    "/api/exports/path/{pathId}.tex": {
      "get": {
        "tags": ["Exports"],
        "operationId": "downloadPathLatex",
        "summary": "Rechenweg als LaTeX laden",
        "x-regelsuche-context": "/api/exports",
        "parameters": [{"$ref": "#/components/parameters/PathId"}],
        "responses": {"200": {"description": "LaTeX-Darstellung des Rechenwegs", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/exports/identity/{identityId}.md": {
      "get": {
        "tags": ["Exports"],
        "operationId": "downloadIdentityMarkdown",
        "summary": "Emergente Identität als Markdown laden",
        "x-regelsuche-context": "/api/exports",
        "parameters": [{"$ref": "#/components/parameters/IdentityId"}],
        "responses": {"200": {"description": "Markdown-Darstellung der Identität", "content": {"text/plain": {"schema": {"type": "string"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/explain/{pathId}": {
      "get": {
        "tags": ["Analysis"],
        "operationId": "explainPath",
        "summary": "Rechenweg in gewählter Darstellungsform erklären",
        "x-regelsuche-context": "/api/explain",
        "parameters": [
          {"$ref": "#/components/parameters/PathId"},
          {"name": "form", "in": "query", "required": false, "schema": {"type": "string", "default": "SCHOOL"}}
        ],
        "responses": {
          "200": {"description": "Erklärung", "content": {"text/plain": {"schema": {"type": "string"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "404": {"$ref": "#/components/responses/NotFound"}
        }
      }
    },
    "/api/analyze/move": {
      "get": {
        "tags": ["Analysis"],
        "operationId": "analyzeMove",
        "summary": "Nächste Züge für einen Ausdruck analysieren",
        "x-regelsuche-context": "/api/analyze",
        "parameters": [{"name": "expression", "in": "query", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "Bester Zug, Alternativen und Sackgassen", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"}
        }
      }
    },
    "/api/demo": {
      "get": {
        "tags": ["Demos"],
        "operationId": "listDemos",
        "summary": "Verfügbare Demos auflisten",
        "x-regelsuche-context": "/api/demo",
        "responses": {"200": {"description": "Demo-Katalog", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/demo/{demoId}": {
      "get": {
        "tags": ["Demos"],
        "operationId": "runDemoGet",
        "summary": "Demo ausführen",
        "x-regelsuche-context": "/api/demo",
        "parameters": [{"$ref": "#/components/parameters/DemoId"}],
        "responses": {"200": {"description": "Vollständiges Demo-Ergebnis", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      },
      "post": {
        "tags": ["Demos"],
        "operationId": "runDemoPost",
        "summary": "Demo einschließlich zustandsändernder Lernabläufe ausführen",
        "x-regelsuche-context": "/api/demo",
        "parameters": [{"$ref": "#/components/parameters/DemoId"}],
        "responses": {"200": {"description": "Vollständiges Demo-Ergebnis", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}, "404": {"$ref": "#/components/responses/NotFound"}}
      }
    },
    "/api/plugins": {
      "get": {
        "tags": ["Plugins"],
        "operationId": "getPluginRuntime",
        "summary": "Plugin-Laufzeit und Katalog laden",
        "x-regelsuche-context": "/api/plugins",
        "parameters": [{"name": "profile", "in": "query", "required": false, "schema": {"type": "string"}}],
        "responses": {"200": {"description": "Geladene Plugins, Regeln, Diagnosen und Profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/plugins/rules": {
      "get": {
        "tags": ["Plugins"],
        "operationId": "listPluginRules",
        "summary": "Registrierte Plugin- und Makroregeln laden",
        "x-regelsuche-context": "/api/plugins",
