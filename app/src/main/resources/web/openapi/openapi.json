        "x-regelsuche-context": "/api/proof-bridge",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ProofRequest"}}}},
        "responses": {
          "200": {"description": "Proof-Artefakt und Ausführungsstatus", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}},
          "400": {"$ref": "#/components/responses/BadRequest"},
          "413": {"$ref": "#/components/responses/PayloadTooLarge"}
