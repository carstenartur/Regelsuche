      }
    },
    "/api/plugins/profiles": {
      "get": {
        "tags": ["Plugins"],
        "operationId": "listPluginProfiles",
        "summary": "Plugin-Aktivierungsprofile laden",
        "x-regelsuche-context": "/api/plugins",
        "responses": {"200": {"description": "Profile", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/JsonObject"}}}}}
      }
    },
    "/api/memory": {
      "get": {
        "tags": ["Memory"],
        "operationId": "getMemoryOverview",
        "summary": "Suchgedächtnis-Übersicht laden",
