# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Generated coverage, test and benchmark pages are CI outputs. They are
# uploaded and published from the central Gradle lifecycle, not source inputs.
public/

# Ignore Kotlin plugin data
.kotlin

# Generated browser-flow videos are produced by `./gradlew e2eTest
# -Pregelsuche.recordDocs=true` and uploaded as CI artifacts; they
# are too large to commit. Screenshots under
# docs/assets/screenshots/ are committed and serve as the canonical
# visual documentation.
docs/assets/videos/
docs/assets/gifs/

# AI knowledge index generated by `./gradlew publishAiKnowledgeIndex`.
# Only committed snapshots (checked in manually) are tracked; the bulk of the
# generated JSON files are excluded to avoid noise in the diff.
docs/ai-knowledge/*.json
