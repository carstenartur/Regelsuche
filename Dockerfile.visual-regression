# Playwright Java image pins browser binaries, system libraries and fonts to the
# exact Playwright version used by app/build.gradle. The project dependency is
# still resolved from the checkout; the image only supplies the runtime stack.
FROM mcr.microsoft.com/playwright/java:v1.62.0-noble@sha256:8c3c9d7c611c24ec695fd396aad1f1957bb4943a429687ea269e3c63b3e6c0bd

WORKDIR /workspace
COPY . .
RUN chmod +x ./gradlew

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    REGELSUCHE_VISUAL_REPORT_DIR=/output

ENTRYPOINT ["./gradlew", "--no-daemon", "--no-configuration-cache", "-Pregelsuche.runVisualTests=true", "-Pregelsuche.skipPlaywrightInstall=true", ":app:e2eTest", "--tests", "de.regelsuche.e2e.MathRenderingVisualTest", "--tests", "de.regelsuche.e2e.VisualRegressionContractTest", "--console=plain"]
