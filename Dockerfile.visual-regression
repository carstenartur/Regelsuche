# Playwright Java image pins browser binaries, system libraries and fonts to the
# exact Playwright version used by app/build.gradle. The project dependency is
# still resolved from the checkout; the image only supplies the runtime stack.
FROM mcr.microsoft.com/playwright/java:v1.65.0-noble@sha256:33872378140440f017536054734d761e01a3908e17bb30f675ae1c959daa46f4

WORKDIR /workspace
COPY . .
RUN chmod +x ./gradlew

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    REGELSUCHE_VISUAL_REPORT_DIR=/output

ENTRYPOINT ["./gradlew", "--no-daemon", "--no-configuration-cache", "-Pregelsuche.runVisualTests=true", "-Pregelsuche.skipPlaywrightInstall=true", ":app:e2eTest", "--tests", "de.regelsuche.e2e.MathRenderingVisualTest", "--tests", "de.regelsuche.e2e.VisualRegressionContractTest", "--tests", "de.regelsuche.e2e.ProofJobPanelBrowserFlowTest.cancelsRunningProofJobAndRetainsTerminalRecord", "--console=plain"]
