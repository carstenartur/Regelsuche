#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# Frozen polynomial study resources are byte-bound and must stay LF-normalized
/regelsuche-experiments/src/main/resources/de/regelsuche/benchmark/polynomial/*.json text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Binary files should be left untouched
*.jar           binary

