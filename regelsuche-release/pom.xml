<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.carstenartur</groupId>
    <artifactId>regelsuche-parent</artifactId>
    <version>0.5.4-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>regelsuche-release</artifactId>
  <name>Regelsuche Release Evidence</name>

  <dependencies>
    <dependency><groupId>org.apache.commons</groupId><artifactId>commons-compress</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>testcontainers-junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.eclipse.jgit</groupId><artifactId>org.eclipse.jgit</artifactId><scope>test</scope></dependency>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-autopilot</artifactId>
    </dependency>
    <dependency><groupId>io.github.carstenartur</groupId><artifactId>regelsuche-discovery</artifactId></dependency>
    <dependency><groupId>io.github.carstenartur</groupId><artifactId>regelsuche-math-algorithms</artifactId></dependency>
    <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId></dependency>
    <dependency><groupId>com.networknt</groupId><artifactId>json-schema-validator</artifactId></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId>
        <executions><execution><id>default-testCompile</id><configuration><compileSourceRoots>
          <compileSourceRoot>${project.basedir}/src/test/java</compileSourceRoot>
          <compileSourceRoot>${project.basedir}/src/maven-test/java</compileSourceRoot>
        </compileSourceRoots></configuration></execution></executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration><argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables><regelsuche.mavenHome>${maven.home}</regelsuche.mavenHome></systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>de.regelsuche.release.ReleaseReadinessMain</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile><id>polynomial-comparison</id><build><plugins><plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId>
      <executions><execution><id>clear-previous-polynomial-reports</id><phase>initialize</phase><goals><goal>clean</goal></goals>
        <configuration><excludeDefaultDirectories>true</excludeDefaultDirectories><filesets>
          <fileset><directory>${project.build.directory}/reports/polynomial-comparison</directory><followSymlinks>false</followSymlinks></fileset>
          <fileset><directory>${project.build.directory}/polynomial-worker-input</directory><followSymlinks>false</followSymlinks></fileset>
        </filesets></configuration></execution></executions>
    </plugin><plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
      <executions><execution><id>run-registered-polynomial-pilot</id><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      <configuration><test>de.regelsuche.release.PolynomialComparisonContainerIT</test>
        <skipTests>false</skipTests><failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
        <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
        <forkedProcessTimeoutInSeconds>1800</forkedProcessTimeoutInSeconds>
      </configuration>
    </plugin></plugins></build></profile>
    <profile><id>native-polynomial-comparison</id><build><plugins><plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId>
      <executions><execution><id>clear-previous-native-polynomial-reports</id><phase>initialize</phase><goals><goal>clean</goal></goals>
        <configuration><excludeDefaultDirectories>true</excludeDefaultDirectories><filesets>
          <fileset><directory>${project.build.directory}/reports/native-polynomial-comparison</directory><followSymlinks>false</followSymlinks></fileset>
          <fileset><directory>${project.build.directory}/native-polynomial-worker-input</directory><followSymlinks>false</followSymlinks></fileset>
        </filesets></configuration></execution></executions>
    </plugin><plugin>
      <groupId>org.apache.maven.plugins</groupId><artifactId>maven-failsafe-plugin</artifactId>
      <executions><execution><id>run-frozen-native-polynomial-study</id><goals><goal>integration-test</goal><goal>verify</goal></goals></execution></executions>
      <configuration><test>de.regelsuche.release.NativePolynomialComparisonContainerIT</test>
        <skipTests>false</skipTests><failIfNoTests>true</failIfNoTests><failIfNoSpecifiedTests>true</failIfNoSpecifiedTests>
        <argLine>@{argLine} --enable-native-access=ALL-UNNAMED</argLine>
        <forkedProcessTimeoutInSeconds>2700</forkedProcessTimeoutInSeconds>
      </configuration>
    </plugin></plugins></build></profile>
  </profiles>
</project>
