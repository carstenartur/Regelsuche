<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.carstenartur</groupId>
    <artifactId>regelsuche-parent</artifactId>
    <version>0.5.4-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>regelsuche-learning</artifactId>
  <name>Regelsuche Learning</name>

  <properties><regelsuche.skipPolynomialClasspath>true</regelsuche.skipPolynomialClasspath></properties>
  <dependencies>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-search</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-math-algorithms</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.carstenartur</groupId>
      <artifactId>regelsuche-solver-ir</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
  </dependencies>
  <build><plugins><plugin>
    <groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId>
    <executions><execution><id>resolve-frozen-study-runtime</id><phase>prepare-package</phase><goals><goal>build-classpath</goal></goals>
      <configuration><includeScope>runtime</includeScope><regenerateFile>true</regenerateFile>
        <skip>${regelsuche.skipPolynomialClasspath}</skip>
        <outputFile>${project.build.directory}/polynomial-runtime-classpath.txt</outputFile>
      </configuration></execution></executions>
  </plugin></plugins></build>
  <profiles>
    <profile><id>polynomial-comparison</id><properties><regelsuche.skipPolynomialClasspath>false</regelsuche.skipPolynomialClasspath></properties></profile>
  </profiles>
</project>
