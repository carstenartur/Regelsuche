{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-research-brief/v1",
  "title": "Regelsuche autonomous target-free research brief v1",
  "type": "object",
  "required": [
    "schema", "briefId", "allowedDomains", "seedGenerators",
    "structuralBounds", "inventoryHash", "packHash", "modelHash",
    "deterministicSeed", "enabledStages", "permittedCapabilities",
    "minimumFamilyDiversity", "minimumSupportDiversity",
    "requireCompleteMandatoryEvidence", "allocationPolicy",
    "stageBudgets", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-research-brief/v1" },
    "briefId": { "$ref": "#/$defs/nonBlank" },
    "allowedDomains": { "$ref": "#/$defs/nonEmptyStringArray" },
    "seedGenerators": { "$ref": "#/$defs/nonEmptyStringArray" },
    "structuralBounds": {
      "type": "object",
      "required": ["maximumDepth", "maximumExpressionNodes", "maximumBranchesPerSeed"],
      "properties": {
        "maximumDepth": { "type": "integer", "minimum": 1 },
        "maximumExpressionNodes": { "type": "integer", "minimum": 1 },
        "maximumBranchesPerSeed": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "inventoryHash": { "$ref": "#/$defs/sha256" },
    "packHash": { "$ref": "#/$defs/sha256" },
    "modelHash": { "$ref": "#/$defs/sha256" },
    "deterministicSeed": { "type": "integer" },
    "enabledStages": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stage" },
      "allOf": [
        { "contains": { "const": "GENERATION" } },
        { "contains": { "const": "CANDIDATE_FORMATION" } }
      ]
    },
    "permittedCapabilities": { "$ref": "#/$defs/stringArray" },
    "minimumFamilyDiversity": { "type": "integer", "minimum": 2 },
    "minimumSupportDiversity": { "type": "integer", "minimum": 2 },
    "requireCompleteMandatoryEvidence": { "type": "boolean" },
    "allocationPolicy": {
      "enum": ["ROUND_ROBIN", "EVIDENCE_COMPLETION_FIRST", "COUNTEREXAMPLE_RISK_FIRST", "BALANCED"]
    },
    "stageBudgets": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["stage", "resources"],
        "properties": {
          "stage": { "$ref": "#/$defs/stage" },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["resource", "configured"],
              "properties": {
                "resource": { "$ref": "#/$defs/resource" },
                "configured": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "stage": { "enum": ["GENERATION", "CANDIDATE_FORMATION", "VALIDATION", "COUNTEREXAMPLE_SEARCH", "PROOF"] },
    "resource": { "enum": ["WALL_CLOCK_MILLIS", "GENERATED_STATES", "EXPLORED_STATES", "CANDIDATES", "VALIDATION_CHECKS", "COUNTEREXAMPLE_ATTEMPTS", "PROOF_ATTEMPTS"] },
    "nonBlank": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } },
    "nonEmptyStringArray": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" } },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
