{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.de/schemas/regelsuche-evolution-rewrite-program-held-out-reveal-draft-v1.schema.json",
  "title": "Regelsuche private held-out reveal draft",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "studyId", "split", "cases"],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-held-out-reveal-draft/v1"
    },
    "studyId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "split": {
      "enum": ["VALIDATION", "FINAL_TEST"]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "familyId",
          "inputExpression",
          "targetExpression",
          "assumptions",
          "difficultyTier",
          "expectedTerminalClass"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,127}$"
          },
          "familyId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{2,127}$"
          },
          "inputExpression": {
            "type": "string",
            "minLength": 1
          },
          "targetExpression": {
            "type": "string",
            "minLength": 1
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "difficultyTier": {
            "enum": ["CONTROL", "STANDARD", "HARD", "BOUNDARY"]
          },
          "expectedTerminalClass": {
            "enum": [
              "CONFIRMED",
              "MISSING_ASSUMPTION",
              "REFUTED",
              "UNSUPPORTED"
            ]
          }
        }
      }
    }
  }
}
