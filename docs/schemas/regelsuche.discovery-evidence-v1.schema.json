{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.discovery-evidence/v1",
  "title": "Regelsuche discovery evidence v1",
  "type": "object",
  "required": [
    "schemaId",
    "profiles",
    "producer",
    "subject",
    "claims",
    "observations",
    "generalizedHypothesis",
    "revisions",
    "assumptions",
    "counterexamples",
    "holdouts",
    "oracleResults",
    "provenance",
    "novelty",
    "ablation",
    "proof",
    "promotion",
    "artifacts",
    "extensions"
  ],
  "properties": {
    "schemaId": {
      "const": "regelsuche.discovery-evidence/v1"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["observed", "validated", "promoted", "public"]
      }
    },
    "canonicalEvidenceId": {
      "type": "string"
    },
    "canonicalEvidenceHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]+$"
    },
    "producer": {
      "type": "object",
      "required": ["producerId", "producerVersion"],
      "properties": {
        "producerId": { "type": "string" },
        "producerVersion": { "type": "string" },
        "implementation": { "type": "string" },
        "sourceRef": { "type": "string" },
        "schemaPath": { "type": "string" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "subject": {
      "type": "object",
      "required": ["id", "kind", "inputExpression", "targetExpression"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "type": "string" },
        "title": { "type": "string" },
        "inputExpression": { "type": "string" },
        "targetExpression": { "type": "string" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "outcome", "statement"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["GENERATED_SUMMARY", "GENERALIZED_HYPOTHESIS"] },
          "outcome": { "enum": ["SUPPORTED", "INCONCLUSIVE", "REFUTED"] },
          "statement": { "type": "string" },
          "evidenceRefs": { "type": "array", "items": { "type": "string" } },
          "extensions": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "outcome"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "outcome": { "enum": ["OBSERVED", "INCONCLUSIVE"] },
          "extensions": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "generalizedHypothesis": {
      "type": "object",
      "required": ["statement", "family", "status"],
      "properties": {
        "statement": { "type": "string" },
        "family": { "type": "string" },
        "status": { "enum": ["SUPPORTED", "INCONCLUSIVE", "REFUTED"] },
        "rulePath": { "type": "array", "items": { "type": "string" } },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "revisions": { "type": "array" },
    "assumptions": { "type": "array" },
    "counterexamples": { "type": "array" },
    "holdouts": { "type": "array" },
    "oracleResults": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "status", "outcome"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["EXTERNAL_VALIDATION"] },
          "status": { "type": "string" },
          "outcome": { "enum": ["CONFIRMED", "REFUTED", "INCONCLUSIVE"] },
          "evidence": { "type": "string" },
          "extensions": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "novelty": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "ablation": {
      "type": "object",
      "required": ["kind", "status", "outcome"],
      "properties": {
        "kind": { "enum": ["ABLATION_STUDY"] },
        "status": { "type": "string" },
        "outcome": { "enum": ["CONFIRMED", "INCONCLUSIVE"] },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "proof": {
      "type": "object",
      "required": ["required", "policy", "outcome", "confirmations"],
      "properties": {
        "required": { "type": "boolean" },
        "policy": { "enum": ["OPTIONAL", "REQUIRED"] },
        "outcome": { "enum": ["NOT_REQUESTED", "CONFIRMED", "INCONCLUSIVE"] },
        "confirmations": { "type": "array" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "promotion": {
      "type": "object",
      "required": ["status", "eligible"],
      "properties": {
        "status": { "enum": ["OBSERVED", "VALIDATED", "PROMOTED", "PUBLIC"] },
        "eligible": { "type": "boolean" },
        "extensions": { "type": "object" }
      },
      "additionalProperties": true
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "path", "mediaType", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "mediaType": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]+$" }
        },
        "additionalProperties": true
      }
    },
    "extensions": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": { "const": "validated" }
          }
        }
      },
      "then": {
        "properties": {
          "oracleResults": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profiles": {
            "contains": { "const": "public" }
          }
        }
      },
      "then": {
        "required": ["canonicalEvidenceId", "canonicalEvidenceHash"],
        "properties": {
          "promotion": {
            "properties": {
              "status": { "const": "PUBLIC" }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
