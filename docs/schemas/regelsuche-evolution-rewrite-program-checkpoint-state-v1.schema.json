{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-checkpoint-state-v1.schema.json",
  "title": "Regelsuche durable rewrite-program checkpoint state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checkpointHash",
    "candidates",
    "evaluations",
    "generationReports",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-checkpoint-state/v1"
    },
    "checkpointHash": {
      "$ref": "#/$defs/sha256"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "evaluations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evaluation"
      }
    },
    "generationReports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/generation"
      }
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "fitnessComponent": {
      "enum": [
        "TRAIN_CASES_NEWLY_SOLVED",
        "TRAIN_PATH_LENGTH_REDUCTION",
        "TRAIN_EXPLORED_STATE_REDUCTION",
        "SUPPORT",
        "STRUCTURAL_DIVERSITY",
        "PROJECT_NOVELTY",
        "ASSUMPTION_SIMPLICITY",
        "CANDIDATE_COMPLEXITY",
        "COUNTEREXAMPLE_RISK",
        "PROOF_COST_PROXY"
      ]
    },
    "mutationKind": {
      "enum": [
        "WRAP_REPEAT",
        "WRAP_REQUIRE",
        "WRAP_PRIORITY",
        "WRAP_PRUNE",
        "PREPEND_SOURCE",
        "APPEND_SOURCE",
        "SWAP_ADJACENT_CHILDREN",
        "REMOVE_WRAPPER",
        "CHOICE_TO_FIRST_APPLICABLE",
        "FIRST_APPLICABLE_TO_CHOICE"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateHash",
        "alphaStructuralHash",
        "genomeJson",
        "planJson"
      ],
      "properties": {
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "alphaStructuralHash": {
          "$ref": "#/$defs/sha256"
        },
        "genomeJson": {
          "type": "string",
          "minLength": 2
        },
        "planJson": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateHash",
        "alphaStructuralHash",
        "rawComponents",
        "blockers",
        "scalarFitness",
        "evidenceHash",
        "contentHash"
      ],
      "properties": {
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "alphaStructuralHash": {
          "$ref": "#/$defs/sha256"
        },
        "rawComponents": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fitnessComponent"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scalarFitness": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 1000
        },
        "evidenceHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentCandidateHash",
        "childCandidateHash",
        "childPlanHash",
        "childAlphaStructuralHash",
        "mutationKind",
        "proposalKey"
      ],
      "properties": {
        "parentCandidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "childCandidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "childPlanHash": {
          "$ref": "#/$defs/sha256"
        },
        "childAlphaStructuralHash": {
          "$ref": "#/$defs/sha256"
        },
        "mutationKind": {
          "$ref": "#/$defs/mutationKind"
        },
        "proposalKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rejection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentCandidateHash",
        "mutationKind",
        "proposalKey",
        "childPlanHash",
        "childAlphaStructuralHash",
        "blockers"
      ],
      "properties": {
        "parentCandidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "mutationKind": {
          "$ref": "#/$defs/mutationKind"
        },
        "proposalKey": {
          "type": "string",
          "minLength": 1
        },
        "childPlanHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "childAlphaStructuralHash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "generation",
        "evaluationHashes",
        "selectedCandidateHashes",
        "lineage",
        "rejections",
        "distinctAlphaStructures",
        "cumulativeMutationAttempts",
        "cumulativeTrainEvaluations",
        "outcome",
        "contentHash"
      ],
      "properties": {
        "schema": {
          "const": "regelsuche.evolution-rewrite-program-generation-report/v1"
        },
        "generation": {
          "type": "integer",
          "minimum": 1
        },
        "evaluationHashes": {
          "$ref": "#/$defs/hashes"
        },
        "selectedCandidateHashes": {
          "$ref": "#/$defs/hashes"
        },
        "lineage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lineage"
          }
        },
        "rejections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/rejection"
          }
        },
        "distinctAlphaStructures": {
          "type": "integer",
          "minimum": 0
        },
        "cumulativeMutationAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "cumulativeTrainEvaluations": {
          "type": "integer",
          "minimum": 0
        },
        "outcome": {
          "enum": [
            "CONTINUE",
            "COMPLETED",
            "EXTINCT",
            "DIVERSITY_FLOOR",
            "BUDGET_EXHAUSTED",
            "STAGNATED"
          ]
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
