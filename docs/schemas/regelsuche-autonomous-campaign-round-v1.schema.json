{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-campaign-round/v1",
  "title": "Regelsuche autonomous campaign feedback round v1",
  "type": "object",
  "required": [
    "schema", "briefHash", "executionLogicalHash", "executionRuntimeHash",
    "nextPlanHash", "roundDecisionIsMathematicalEvidence",
    "promotionStatus", "publicEvidenceStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-campaign-round/v1" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "executionLogicalHash": { "$ref": "#/$defs/sha256" },
    "executionRuntimeHash": { "$ref": "#/$defs/sha256" },
    "nextPlanHash": { "$ref": "#/$defs/sha256" },
    "roundDecisionIsMathematicalEvidence": { "const": false },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
