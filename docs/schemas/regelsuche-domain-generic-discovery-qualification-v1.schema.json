{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.domain-generic-discovery-qualification/v1",
  "title": "Regelsuche domain-generic discovery qualification v1",
  "description": "Fail-closed evidence report for the separate domain-generic discovery claim. Schema validity alone is not an authenticity decision.",
  "type": "object",
  "required": [
    "schema",
    "profile",
    "claim",
    "status",
    "domainGenericClaimAuthorized",
    "autonomousCampaignClaimAuthorized",
    "cleanRunCount",
    "cleanRunsIdentical",
    "domains",
    "checks",
    "blockers",
    "proofStatus",
    "externalNoveltyStatus",
    "promotionStatus",
    "publicEvidenceStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.domain-generic-discovery-qualification/v1"
    },
    "profile": {
      "const": "DOMAIN_GENERIC_DISCOVERY"
    },
    "claim": {
      "const": "reproducible generation, bounded search, counterexample search, validation, certificate rendering and evidence across distinct mathematical object types"
    },
    "status": {
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "domainGenericClaimAuthorized": {
      "type": "boolean"
    },
    "autonomousCampaignClaimAuthorized": {
      "const": false
    },
    "cleanRunCount": {
      "type": "integer",
      "minimum": 0
    },
    "cleanRunsIdentical": {
      "type": "boolean"
    },
    "domains": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/domain"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "AT_LEAST_TWO_DISTINCT_DOMAINS"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "BALANCED_RESOURCE_ACCOUNTING"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "CONFIRMED_CANDIDATES_WITH_CERTIFICATES"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "DISTINCT_MATHEMATICAL_STATE_TYPES"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "EXPRESSION_REWRITE_DOMAIN_RETAINED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "EXTERNAL_NOVELTY_STATUS_NOT_EVALUATED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "NON_EXPRESSION_DOMAIN_RETAINED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "PROMOTION_STATUS_NOT_EVALUATED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "PROOF_STATUS_NOT_EVALUATED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "PUBLIC_EVIDENCE_STATUS_NOT_EVALUATED"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "REPRESENTATION_FREE_LIFECYCLE_HANDOFF"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "SHARED_RESOURCE_ACCOUNTING"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "THREE_CLEAN_MULTI_DOMAIN_RUNS"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/check"
            },
            {
              "properties": {
                "code": {
                  "const": "VERIFIED_EXPORT_SNAPSHOTS"
                }
              },
              "required": [
                "code"
              ]
            }
          ]
        }
      ],
      "items": false
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "proofStatus": {
      "const": "NOT_EVALUATED"
    },
    "externalNoveltyStatus": {
      "const": "NOT_EVALUATED"
    },
    "promotionStatus": {
      "const": "NOT_EVALUATED"
    },
    "publicEvidenceStatus": {
      "const": "NOT_EVALUATED"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "READY"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "domainGenericClaimAuthorized": {
            "const": true
          },
          "cleanRunCount": {
            "minimum": 3
          },
          "cleanRunsIdentical": {
            "const": true
          },
          "domains": {
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/readyDomain"
            },
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "domainId": {
                      "const": "expression-rewrite"
                    }
                  },
                  "required": [
                    "domainId"
                  ]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "domainId": {
                      "not": {
                        "const": "expression-rewrite"
                      }
                    }
                  },
                  "required": [
                    "domainId"
                  ]
                },
                "minContains": 1
              }
            ]
          },
          "checks": {
            "prefixItems": [
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              },
              {
                "properties": {
                  "passed": {
                    "const": true
                  }
                },
                "required": [
                  "passed"
                ]
              }
            ]
          },
          "blockers": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "domainGenericClaimAuthorized": {
            "const": false
          },
          "checks": {
            "contains": {
              "properties": {
                "passed": {
                  "const": false
                }
              },
              "required": [
                "passed"
              ]
            },
            "minContains": 1
          },
          "blockers": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256OrEmpty": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "resourceNames": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "prefixItems": [
        {
          "const": "CANDIDATE_EVALUATIONS"
        },
        {
          "const": "CERTIFICATE_ATTEMPTS"
        },
        {
          "const": "COUNTEREXAMPLE_ATTEMPTS"
        },
        {
          "const": "EXPLORED_STATES"
        },
        {
          "const": "GENERATED_SUCCESSORS"
        }
      ],
      "items": false
    },
    "domain": {
      "type": "object",
      "required": [
        "domainId",
        "domainRevision",
        "stateType",
        "candidateType",
        "certificateType",
        "domainDescriptorHash",
        "discoveryEvidenceHash",
        "lifecycleHandoffHash",
        "exportVerificationHash",
        "identityBindingStatus",
        "outcome",
        "selectedCandidateHash",
        "certificateHash",
        "resourceNames",
        "resourcesBalanced",
        "representationFreeHandoff",
        "proofStatus",
        "externalNoveltyStatus",
        "promotionStatus",
        "publicEvidenceStatus"
      ],
      "properties": {
        "domainId": {
          "$ref": "#/$defs/identifier"
        },
        "domainRevision": {
          "$ref": "#/$defs/identifier"
        },
        "stateType": {
          "$ref": "#/$defs/identifier"
        },
        "candidateType": {
          "$ref": "#/$defs/identifier"
        },
        "certificateType": {
          "$ref": "#/$defs/identifier"
        },
        "domainDescriptorHash": {
          "$ref": "#/$defs/sha256"
        },
        "discoveryEvidenceHash": {
          "$ref": "#/$defs/sha256"
        },
        "lifecycleHandoffHash": {
          "$ref": "#/$defs/sha256"
        },
        "exportVerificationHash": {
          "$ref": "#/$defs/sha256"
        },
        "identityBindingStatus": {
          "const": "VERIFIED"
        },
        "outcome": {
          "enum": [
            "CONFIRMED",
            "REFUTED",
            "INCONCLUSIVE",
            "UNSUPPORTED",
            "BUDGET_EXHAUSTED",
            "INVALID_SEED"
          ]
        },
        "selectedCandidateHash": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "certificateHash": {
          "$ref": "#/$defs/sha256OrEmpty"
        },
        "resourceNames": {
          "$ref": "#/$defs/resourceNames"
        },
        "resourcesBalanced": {
          "type": "boolean"
        },
        "representationFreeHandoff": {
          "type": "boolean"
        },
        "proofStatus": {
          "const": "NOT_EVALUATED"
        },
        "externalNoveltyStatus": {
          "const": "NOT_EVALUATED"
        },
        "promotionStatus": {
          "const": "NOT_EVALUATED"
        },
        "publicEvidenceStatus": {
          "const": "NOT_EVALUATED"
        }
      },
      "additionalProperties": false
    },
    "readyDomain": {
      "allOf": [
        {
          "$ref": "#/$defs/domain"
        },
        {
          "properties": {
            "outcome": {
              "const": "CONFIRMED"
            },
            "selectedCandidateHash": {
              "$ref": "#/$defs/sha256"
            },
            "certificateHash": {
              "$ref": "#/$defs/sha256"
            },
            "resourcesBalanced": {
              "const": true
            },
            "representationFreeHandoff": {
              "const": true
            }
          },
          "required": [
            "outcome",
            "selectedCandidateHash",
            "certificateHash",
            "resourcesBalanced",
            "representationFreeHandoff"
          ]
        }
      ]
    },
    "check": {
      "type": "object",
      "required": [
        "code",
        "passed",
        "actual",
        "required"
      ],
      "properties": {
        "code": {
          "$ref": "#/$defs/identifier"
        },
        "passed": {
          "type": "boolean"
        },
        "actual": {
          "$ref": "#/$defs/nonBlank"
        },
        "required": {
          "$ref": "#/$defs/nonBlank"
        }
      },
      "additionalProperties": false
    }
  }
}
