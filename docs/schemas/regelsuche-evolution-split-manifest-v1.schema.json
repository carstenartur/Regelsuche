{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.evolution-split-manifest/v1",
  "title": "Regelsuche evolution split manifest v1",
  "type": "object",
  "required": [
    "schema",
    "studyId",
    "corpusHash",
    "featureSchemaHash",
    "trainCases",
    "validationCases",
    "finalTestCases",
    "familyPartitionHash",
    "signaturePartitionHash",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-split-manifest/v1"
    },
    "studyId": {
      "$ref": "#/$defs/id"
    },
    "corpusHash": {
      "$ref": "#/$defs/sha256"
    },
    "featureSchemaHash": {
      "$ref": "#/$defs/sha256"
    },
    "trainCases": {
      "$ref": "#/$defs/cases"
    },
    "validationCases": {
      "$ref": "#/$defs/cases"
    },
    "finalTestCases": {
      "$ref": "#/$defs/cases"
    },
    "familyPartitionHash": {
      "$ref": "#/$defs/sha256"
    },
    "signaturePartitionHash": {
      "$ref": "#/$defs/sha256"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "case": {
      "type": "object",
      "required": [
        "caseId",
        "familyId",
        "exactSignatureHash",
        "alphaSignatureHash",
        "inputHash",
        "hiddenTargetHash"
      ],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/id"
        },
        "familyId": {
          "$ref": "#/$defs/id"
        },
        "exactSignatureHash": {
          "$ref": "#/$defs/sha256"
        },
        "alphaSignatureHash": {
          "$ref": "#/$defs/sha256"
        },
        "inputHash": {
          "$ref": "#/$defs/sha256"
        },
        "hiddenTargetHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
