{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-learned-rule-promotion-evidence-root-v1.schema.json",
  "title": "Regelsuche learned-rule promotion evidence root v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "role",
    "status",
    "genomeHash",
    "geneId",
    "repositoryRevision",
    "issuedAt",
    "expiresAt",
    "artifactHash",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.learned-rule-promotion-evidence-root/v1"
    },
    "role": {
      "enum": [
        "SEMANTIC_VALIDATION",
        "COUNTEREXAMPLE_SEARCH",
        "HOLDOUT_EVALUATION",
        "LEAKAGE_AUDIT"
      ]
    },
    "status": {
      "type": "string"
    },
    "genomeHash": {
      "$ref": "#/$defs/sha256"
    },
    "geneId": {
      "type": "string",
      "minLength": 1
    },
    "repositoryRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifactHash": {
      "$ref": "#/$defs/sha256"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "COUNTEREXAMPLE_SEARCH"}}},
      "then": {"properties": {"status": {"const": "NO_COUNTEREXAMPLE_FOUND"}}}
    },
    {
      "if": {
        "properties": {
          "role": {
            "enum": [
              "SEMANTIC_VALIDATION",
              "HOLDOUT_EVALUATION",
              "LEAKAGE_AUDIT"
            ]
          }
        }
      },
      "then": {"properties": {"status": {"const": "PASSED"}}}
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
