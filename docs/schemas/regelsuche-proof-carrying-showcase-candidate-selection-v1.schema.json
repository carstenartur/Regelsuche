{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.proof-carrying-showcase-candidate-selection/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "showcaseId",
    "planContentHash",
    "retainedPopulationRunHash",
    "populationRunHash",
    "finalGenerationReportHash",
    "populationTerminalOutcome",
    "selectionPolicy",
    "alternatives",
    "selectedCandidateHash",
    "selectedCandidateAlphaStructuralHash",
    "selectedPlanHash",
    "status",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.proof-carrying-showcase-candidate-selection/v1"
    },
    "showcaseId": {
      "const": "proof-carrying-self-improvement-2026-08/v1"
    },
    "planContentHash": {
      "$ref": "#/$defs/sha256"
    },
    "retainedPopulationRunHash": {
      "$ref": "#/$defs/sha256"
    },
    "populationRunHash": {
      "$ref": "#/$defs/sha256"
    },
    "finalGenerationReportHash": {
      "$ref": "#/$defs/sha256"
    },
    "populationTerminalOutcome": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "DIVERSITY_FLOOR",
        "BUDGET_EXHAUSTED",
        "STAGNATED"
      ]
    },
    "selectionPolicy": {
      "const": "MAX_TRAIN_SCALAR_THEN_MIN_PROGRAM_NODES_THEN_CANDIDATE_HASH_AMONG_NON_SEED_COMPOSITE_DECISION_CANDIDATES"
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/alternative"
      }
    },
    "selectedCandidateHash": {
      "$ref": "#/$defs/sha256"
    },
    "selectedCandidateAlphaStructuralHash": {
      "$ref": "#/$defs/sha256"
    },
    "selectedPlanHash": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "TRAIN_SELECTION_FROZEN_FINAL_TEST_UNSEEN"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fitnessComponents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "TRAIN_CASES_NEWLY_SOLVED": {
          "$ref": "#/$defs/fitnessValue"
        },
        "TRAIN_PATH_LENGTH_REDUCTION": {
          "$ref": "#/$defs/fitnessValue"
        },
        "TRAIN_EXPLORED_STATE_REDUCTION": {
          "$ref": "#/$defs/fitnessValue"
        },
        "SUPPORT": {
          "$ref": "#/$defs/fitnessValue"
        },
        "STRUCTURAL_DIVERSITY": {
          "$ref": "#/$defs/fitnessValue"
        },
        "PROJECT_NOVELTY": {
          "$ref": "#/$defs/fitnessValue"
        },
        "ASSUMPTION_SIMPLICITY": {
          "$ref": "#/$defs/fitnessValue"
        },
        "CANDIDATE_COMPLEXITY": {
          "$ref": "#/$defs/fitnessValue"
        },
        "COUNTEREXAMPLE_RISK": {
          "$ref": "#/$defs/fitnessValue"
        },
        "PROOF_COST_PROXY": {
          "$ref": "#/$defs/fitnessValue"
        }
      }
    },
    "fitnessValue": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateHash",
        "alphaStructuralHash",
        "genomeHash",
        "planHash",
        "evaluationHash",
        "scalarFitness",
        "rawComponents",
        "trainBlockers",
        "seedExactEquivalent",
        "seedAlphaEquivalent",
        "programNodeCount",
        "containsCompositionTopology",
        "containsDecisionTopology",
        "minimumStructuralPrimitivePathSteps",
        "freezeBlockers",
        "eligibleForFreeze"
      ],
      "properties": {
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "alphaStructuralHash": {
          "$ref": "#/$defs/sha256"
        },
        "genomeHash": {
          "$ref": "#/$defs/sha256"
        },
        "planHash": {
          "$ref": "#/$defs/sha256"
        },
        "evaluationHash": {
          "$ref": "#/$defs/sha256"
        },
        "scalarFitness": {
          "$ref": "#/$defs/fitnessValue"
        },
        "rawComponents": {
          "$ref": "#/$defs/fitnessComponents"
        },
        "trainBlockers": {
          "$ref": "#/$defs/blockers"
        },
        "seedExactEquivalent": {
          "type": "boolean"
        },
        "seedAlphaEquivalent": {
          "type": "boolean"
        },
        "programNodeCount": {
          "type": "integer",
          "minimum": 1
        },
        "containsCompositionTopology": {
          "type": "boolean"
        },
        "containsDecisionTopology": {
          "type": "boolean"
        },
        "minimumStructuralPrimitivePathSteps": {
          "type": "integer",
          "minimum": 1
        },
        "freezeBlockers": {
          "$ref": "#/$defs/blockers"
        },
        "eligibleForFreeze": {
          "type": "boolean"
        }
      }
    }
  }
}
