{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.evolution-study-plan/v1",
  "title": "Regelsuche evolution study plan v1",
  "type": "object",
  "required": [
    "schema",
    "studyId",
    "objective",
    "splitManifestHash",
    "seedGenomeHashes",
    "mutationOperators",
    "populationPolicy",
    "fitnessWeights",
    "budget",
    "status",
    "finalTestPolicy",
    "proofStatus",
    "externalNoveltyStatus",
    "promotionStatus",
    "publicEvidenceStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-study-plan/v1"
    },
    "studyId": {
      "$ref": "#/$defs/id"
    },
    "objective": {
      "enum": [
        "OPEN_TARGET_OPERATOR",
        "TARGET_DIRECTED_POLICY"
      ]
    },
    "splitManifestHash": {
      "$ref": "#/$defs/sha256"
    },
    "seedGenomeHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "mutationOperators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ADD_ASSUMPTION",
          "ADD_RANKING_FEATURE",
          "COMPOSE_REWRITES",
          "GENERALIZE_PLACEHOLDER",
          "REMOVE_ASSUMPTION",
          "REMOVE_RANKING_FEATURE",
          "REVERSE_REWRITE",
          "SPECIALIZE_PLACEHOLDER"
        ]
      }
    },
    "populationPolicy": {
      "$ref": "#/$defs/populationPolicy"
    },
    "fitnessWeights": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fitnessWeight"
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "status": {
      "const": "NOT_STARTED"
    },
    "finalTestPolicy": {
      "const": "ONE_TIME_AFTER_FROZEN_VALIDATION_SELECTION"
    },
    "proofStatus": {
      "const": "NOT_EVALUATED"
    },
    "externalNoveltyStatus": {
      "const": "NOT_EVALUATED"
    },
    "promotionStatus": {
      "const": "NOT_EVALUATED"
    },
    "publicEvidenceStatus": {
      "const": "NOT_EVALUATED"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "populationPolicy": {
      "type": "object",
      "required": [
        "populationSize",
        "generationCount",
        "eliteCount",
        "minimumDistinctAlphaStructures",
        "maxOffspringPerLineage",
        "parallelism",
        "randomSeed"
      ],
      "properties": {
        "populationSize": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "generationCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "eliteCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "minimumDistinctAlphaStructures": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100000
        },
        "maxOffspringPerLineage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "parallelism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "randomSeed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "fitnessWeight": {
      "type": "object",
      "required": [
        "component",
        "weightPermille"
      ],
      "properties": {
        "component": {
          "enum": [
            "ASSUMPTION_SIMPLICITY",
            "CANDIDATE_COMPLEXITY",
            "COUNTEREXAMPLE_RISK",
            "PROJECT_NOVELTY",
            "PROOF_COST_PROXY",
            "STRUCTURAL_DIVERSITY",
            "SUPPORT",
            "TRAIN_CASES_NEWLY_SOLVED",
            "TRAIN_EXPLORED_STATE_REDUCTION",
            "TRAIN_PATH_LENGTH_REDUCTION"
          ]
        },
        "weightPermille": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "maxMutationAttempts",
        "maxTrainEvaluations",
        "maxValidationEvaluations",
        "maxFinalTestEvaluations",
        "maxCheckpoints"
      ],
      "properties": {
        "maxMutationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxTrainEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxValidationEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxFinalTestEvaluations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "maxCheckpoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
