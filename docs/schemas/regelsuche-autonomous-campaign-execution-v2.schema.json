{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-campaign-execution/v2",
  "title": "Regelsuche aggregate autonomous campaign execution v2",
  "type": "object",
  "required": [
    "schema", "decisionHash", "miningReportHash", "campaignId",
    "ruleInventoryHash", "status", "outputBranches", "lineages",
    "rejectedClusters", "candidateRejections",
    "executionIsMathematicalEvidence", "promotionStatus",
    "publicEvidenceStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-campaign-execution/v2" },
    "decisionHash": { "$ref": "#/$defs/sha256" },
    "miningReportHash": { "$ref": "#/$defs/sha256" },
    "campaignId": { "$ref": "#/$defs/nonBlank" },
    "ruleInventoryHash": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["COMPLETED", "ZERO_OUTPUT", "BLOCKED"] },
    "outputBranches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branchId", "type", "snapshotHash", "evidenceHash", "status"],
        "properties": {
          "branchId": { "$ref": "#/$defs/nonBlank" },
          "type": { "const": "CONJECTURE_CANDIDATE" },
          "snapshotHash": { "$ref": "#/$defs/sha256" },
          "evidenceHash": { "$ref": "#/$defs/sha256" },
          "status": { "enum": ["ELIGIBLE_INCOMPLETE", "COMPLETE", "DUPLICATE", "DISPROVED", "INCONCLUSIVE"] }
        },
        "additionalProperties": false
      }
    },
    "lineages": {
      "type": "array",
      "items": { "$ref": "./regelsuche-autonomous-branch-lineage-v2.schema.json" }
    },
    "rejectedClusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["clusterId", "reason", "evidenceHash"],
        "properties": {
          "clusterId": { "$ref": "#/$defs/nonBlank" },
          "reason": { "$ref": "#/$defs/nonBlank" },
          "evidenceHash": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    },
    "candidateRejections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidateId", "convergenceEvidenceHash", "blockers"],
        "properties": {
          "candidateId": { "$ref": "#/$defs/nonBlank" },
          "convergenceEvidenceHash": { "$ref": "#/$defs/sha256" },
          "blockers": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/nonBlank" }
          }
        },
        "additionalProperties": false
      }
    },
    "executionIsMathematicalEvidence": { "const": false },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
