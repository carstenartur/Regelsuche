{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-evaluation-protocol-v1.schema.json",
  "title": "Regelsuche rewrite-program evaluation protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocolId",
    "evaluatorProfile",
    "baselineContract",
    "candidateContract",
    "targetRelation",
    "correctnessContract",
    "workAccountingContract",
    "resourceAttributionContract",
    "implementationClass",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-evaluation-protocol/v1"
    },
    "protocolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "evaluatorProfile": {
      "const": "EXACT_RATIONAL_NORMAL_FORM_WITH_DECLARED_ASSUMPTIONS"
    },
    "baselineContract": {
      "const": "ORDINARY_PLUS_FLAT_CANDIDATE_GENOME_RULES"
    },
    "candidateContract": {
      "const": "BASELINE_PLUS_COMPILED_REWRITE_PROGRAM"
    },
    "targetRelation": {
      "const": "SYNTAX_EXACT"
    },
    "correctnessContract": {
      "const": "EXACT_RATIONAL_NORMAL_FORM_PER_PATH_EDGE_WITH_DECLARED_ASSUMPTIONS"
    },
    "workAccountingContract": {
      "const": "STRUCTURED_PRIMITIVE_LINEAGE_AND_TOTAL_MECHANICAL_WORK_V1"
    },
    "resourceAttributionContract": {
      "const": "CONFIRMED_PROGRAM_PATH_AND_NONINCREASING_TOTAL_WORK"
    },
    "implementationClass": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
