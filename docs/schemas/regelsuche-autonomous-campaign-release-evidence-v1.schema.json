{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-campaign-release-evidence/v1",
  "title": "Regelsuche autonomous campaign release evidence v1",
  "type": "object",
  "required": [
    "schema", "campaignManifestHash", "cleanRunManifestHashes",
    "cleanRunCount", "cleanRunsIdentical", "targetFree",
    "seedFamilyCount", "observationCount", "candidateCount",
    "rejectedClusterCount", "alphaDistinctSupport",
    "aggregateMiningComplete", "exactSupportingLineage",
    "mandatorySkippedWorkCount", "heldOutFamilyOrClusterCount",
    "configuredFreshHoldouts", "executedFreshHoldouts",
    "refutingHoldouts", "counterexampleStrategyCount",
    "counterexamplesFound", "projectNoveltyStatus",
    "externalNoveltyStatus", "symbolicProofStatus",
    "formalProofStatus", "unresolvedAssumptionCount",
    "lifecycleHandoffComplete", "pairedHeldOutUtilityEvaluated",
    "pairedUtilityPermille", "hiddenReferenceIsolated",
    "hiddenRuleBenchmarkComplete", "executableRediscoveryRetained",
    "domainGenericSearchInterfaceReady", "publicEvidenceReviewed",
    "evidenceHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-campaign-release-evidence/v1" },
    "campaignManifestHash": { "$ref": "#/$defs/sha256" },
    "cleanRunManifestHashes": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "cleanRunCount": { "type": "integer", "minimum": 1 },
    "cleanRunsIdentical": { "type": "boolean" },
    "targetFree": { "type": "boolean" },
    "seedFamilyCount": { "type": "integer", "minimum": 0 },
    "observationCount": { "type": "integer", "minimum": 0 },
    "candidateCount": { "type": "integer", "minimum": 0 },
    "rejectedClusterCount": { "type": "integer", "minimum": 0 },
    "alphaDistinctSupport": { "type": "integer", "minimum": 0 },
    "aggregateMiningComplete": { "type": "boolean" },
    "exactSupportingLineage": { "type": "boolean" },
    "mandatorySkippedWorkCount": { "type": "integer", "minimum": 0 },
    "heldOutFamilyOrClusterCount": { "type": "integer", "minimum": 0 },
    "configuredFreshHoldouts": { "type": "integer", "minimum": 0 },
    "executedFreshHoldouts": { "type": "integer", "minimum": 0 },
    "refutingHoldouts": { "type": "integer", "minimum": 0 },
    "counterexampleStrategyCount": { "type": "integer", "minimum": 0 },
    "counterexamplesFound": { "type": "integer", "minimum": 0 },
    "projectNoveltyStatus": { "$ref": "#/$defs/nonBlank" },
    "externalNoveltyStatus": { "$ref": "#/$defs/nonBlank" },
    "symbolicProofStatus": { "$ref": "#/$defs/nonBlank" },
    "formalProofStatus": { "$ref": "#/$defs/nonBlank" },
    "unresolvedAssumptionCount": { "type": "integer", "minimum": 0 },
    "lifecycleHandoffComplete": { "type": "boolean" },
    "pairedHeldOutUtilityEvaluated": { "type": "boolean" },
    "pairedUtilityPermille": { "type": "integer", "minimum": 0 },
    "hiddenReferenceIsolated": { "type": "boolean" },
    "hiddenRuleBenchmarkComplete": { "type": "boolean" },
    "executableRediscoveryRetained": { "type": "boolean" },
    "domainGenericSearchInterfaceReady": { "type": "boolean" },
    "publicEvidenceReviewed": { "type": "boolean" },
    "evidenceHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
