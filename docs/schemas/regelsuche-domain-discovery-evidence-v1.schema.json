{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.domain-discovery-evidence/v1",
  "title": "Regelsuche domain-neutral discovery evidence v1",
  "type": "object",
  "required": [
    "schema",
    "campaignId",
    "domain",
    "seed",
    "budget",
    "outcome",
    "summary",
    "states",
    "transitions",
    "candidateAttempts",
    "resources",
    "selectedCandidateHash",
    "certificate",
    "domainEvidence",
    "proofStatus",
    "externalNoveltyStatus",
    "promotionStatus",
    "publicEvidenceStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.domain-discovery-evidence/v1"
    },
    "campaignId": {
      "$ref": "#/$defs/identifier"
    },
    "domain": {
      "$ref": "#/$defs/domainDescriptor"
    },
    "seed": {
      "$ref": "#/$defs/seed"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "outcome": {
      "enum": [
        "CONFIRMED",
        "REFUTED",
        "INCONCLUSIVE",
        "UNSUPPORTED",
        "BUDGET_EXHAUSTED",
        "INVALID_SEED"
      ]
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "transitions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "candidateAttempts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/candidateAttempt"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "selectedCandidateHash": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    },
    "certificate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/certificate"
        }
      ]
    },
    "domainEvidence": {
      "$ref": "#/$defs/domainEvidence"
    },
    "proofStatus": {
      "const": "NOT_EVALUATED"
    },
    "externalNoveltyStatus": {
      "const": "NOT_EVALUATED"
    },
    "promotionStatus": {
      "const": "NOT_EVALUATED"
    },
    "publicEvidenceStatus": {
      "const": "NOT_EVALUATED"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "CONFIRMED"
          }
        }
      },
      "then": {
        "properties": {
          "selectedCandidateHash": {
            "$ref": "#/$defs/sha256"
          },
          "certificate": {
            "$ref": "#/$defs/certificate"
          }
        }
      },
      "else": {
        "properties": {
          "selectedCandidateHash": {
            "type": "null"
          },
          "certificate": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "keyValue": {
      "type": "object",
      "required": [
        "key",
        "value"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "keyValues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/keyValue"
      }
    },
    "seed": {
      "type": "object",
      "required": [
        "schema",
        "seedId",
        "domainId",
        "payload",
        "sourceReference",
        "contentHash"
      ],
      "properties": {
        "schema": {
          "const": "regelsuche.discovery-seed/v1"
        },
        "seedId": {
          "$ref": "#/$defs/identifier"
        },
        "domainId": {
          "$ref": "#/$defs/identifier"
        },
        "payload": {
          "type": "string",
          "minLength": 1
        },
        "sourceReference": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": [
        "maxDepth",
        "maxExploredStates",
        "maxGeneratedSuccessors",
        "maxCandidatesPerState",
        "maxCandidateAttempts",
        "maxCounterexampleAttempts"
      ],
      "properties": {
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "maxExploredStates": {
          "type": "integer",
          "minimum": 1
        },
        "maxGeneratedSuccessors": {
          "type": "integer",
          "minimum": 1
        },
        "maxCandidatesPerState": {
          "type": "integer",
          "minimum": 1
        },
        "maxCandidateAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "maxCounterexampleAttempts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "exploredStates",
        "generatedTransitions",
        "acceptedTransitions",
        "rejectedTransitions",
        "candidateAttempts",
        "counterexampleAttempts"
      ],
      "properties": {
        "exploredStates": {
          "type": "integer",
          "minimum": 0
        },
        "generatedTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "rejectedTransitions": {
          "type": "integer",
          "minimum": 0
        },
        "candidateAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "counterexampleAttempts": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "sequence",
        "stateHash",
        "canonicalState",
        "depth",
        "objectiveScore",
        "candidateReady",
        "parentStateHash",
        "actionId",
        "objectiveMetrics"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "stateHash": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalState": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "type": "integer",
          "minimum": 0
        },
        "objectiveScore": {
          "type": "integer"
        },
        "candidateReady": {
          "type": "boolean"
        },
        "parentStateHash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "actionId": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/identifier"
            }
          ]
        },
        "objectiveMetrics": {
          "$ref": "#/$defs/keyValues"
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": [
        "sequence",
        "fromStateHash",
        "toStateHash",
        "actionId",
        "cost",
        "semanticsPreserving",
        "accepted",
        "assumptions",
        "blockers",
        "metadata"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "fromStateHash": {
          "$ref": "#/$defs/sha256"
        },
        "toStateHash": {
          "$ref": "#/$defs/sha256"
        },
        "actionId": {
          "$ref": "#/$defs/identifier"
        },
        "cost": {
          "type": "integer",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "semanticsPreserving": {
          "type": "boolean"
        },
        "accepted": {
          "type": "boolean"
        },
        "assumptions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "metadata": {
          "$ref": "#/$defs/keyValues"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "accepted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "blockers": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "blockers": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "candidateAttempt": {
      "type": "object",
      "required": [
        "sequence",
        "candidateHash",
        "disposition",
        "counterexampleStatus",
        "counterexampleAttempts",
        "counterexampleWitness",
        "evaluationStatus",
        "evaluationSummary",
        "certificateHash",
        "metrics"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "candidateHash": {
          "$ref": "#/$defs/sha256"
        },
        "disposition": {
          "enum": [
            "CONFIRMED",
            "REFUTED_BY_COUNTEREXAMPLE",
            "REFUTED_BY_EVALUATOR",
            "INCONCLUSIVE",
            "UNSUPPORTED"
          ]
        },
        "counterexampleStatus": {
          "enum": [
            "NONE_FOUND",
            "FOUND",
            "INCONCLUSIVE",
            "UNSUPPORTED"
          ]
        },
        "counterexampleAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "counterexampleWitness": {
          "type": "string"
        },
        "evaluationStatus": {
          "enum": [
            "NOT_RUN",
            "CONFIRMED",
            "REFUTED",
            "INCONCLUSIVE",
            "UNSUPPORTED"
          ]
        },
        "evaluationSummary": {
          "type": "string"
        },
        "certificateHash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "metrics": {
          "$ref": "#/$defs/keyValues"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "CONFIRMED"
              }
            }
          },
          "then": {
            "properties": {
              "evaluationStatus": {
                "const": "CONFIRMED"
              },
              "certificateHash": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "required": [
        "resource",
        "configured",
        "executed",
        "skipped",
        "remaining"
      ],
      "properties": {
        "resource": {
          "enum": [
            "EXPLORED_STATES",
            "GENERATED_SUCCESSORS",
            "CANDIDATE_EVALUATIONS",
            "COUNTEREXAMPLE_ATTEMPTS",
            "CERTIFICATE_ATTEMPTS"
          ]
        },
        "configured": {
          "type": "integer",
          "minimum": 0
        },
        "executed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "remaining": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "certificate": {
      "type": "object",
      "required": [
        "kind",
        "format",
        "certificateObjectHash",
        "rendered",
        "contentHash"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/identifier"
        },
        "format": {
          "$ref": "#/$defs/identifier"
        },
        "certificateObjectHash": {
          "$ref": "#/$defs/sha256"
        },
        "rendered": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "domainEvidence": {
      "type": "object",
      "required": [
        "type",
        "properties"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/identifier"
        },
        "properties": {
          "$ref": "#/$defs/keyValues"
        }
      },
      "additionalProperties": false
    },
    "domainDescriptor": {
      "type": "object",
      "required": [
        "schema",
        "domainId",
        "revision",
        "stateType",
        "candidateType",
        "certificateType",
        "generatorId",
        "stateCodecId",
        "operatorIds",
        "invariantIds",
        "objectiveId",
        "candidateExtractorId",
        "candidateCodecId",
        "counterexampleGeneratorId",
        "evaluatorId",
        "certificateCodecId",
        "certificateRendererId",
        "evidenceAdapterId",
        "deterministic",
        "semanticRoles",
        "contentHash"
      ],
      "properties": {
        "schema": {
          "const": "regelsuche.discovery-domain-descriptor/v1"
        },
        "domainId": {
          "$ref": "#/$defs/identifier"
        },
        "revision": {
          "$ref": "#/$defs/identifier"
        },
        "stateType": {
          "$ref": "#/$defs/identifier"
        },
        "candidateType": {
          "$ref": "#/$defs/identifier"
        },
        "certificateType": {
          "$ref": "#/$defs/identifier"
        },
        "generatorId": {
          "$ref": "#/$defs/identifier"
        },
        "stateCodecId": {
          "$ref": "#/$defs/identifier"
        },
        "operatorIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "invariantIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "objectiveId": {
          "$ref": "#/$defs/identifier"
        },
        "candidateExtractorId": {
          "$ref": "#/$defs/identifier"
        },
        "candidateCodecId": {
          "$ref": "#/$defs/identifier"
        },
        "counterexampleGeneratorId": {
          "$ref": "#/$defs/identifier"
        },
        "evaluatorId": {
          "$ref": "#/$defs/identifier"
        },
        "certificateCodecId": {
          "$ref": "#/$defs/identifier"
        },
        "certificateRendererId": {
          "$ref": "#/$defs/identifier"
        },
        "evidenceAdapterId": {
          "$ref": "#/$defs/identifier"
        },
        "deterministic": {
          "const": true
        },
        "semanticRoles": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GENERATION",
              "CANONICALIZATION",
              "INVARIANT_CHECKING",
              "SEARCH",
              "CANDIDATE_FORMATION",
              "COUNTEREXAMPLE_SEARCH",
              "VALIDATION",
              "CERTIFICATE_RENDERING",
              "EVIDENCE_ADAPTATION"
            ]
          },
          "allOf": [
            {
              "contains": {
                "const": "GENERATION"
              }
            },
            {
              "contains": {
                "const": "CANONICALIZATION"
              }
            },
            {
              "contains": {
                "const": "INVARIANT_CHECKING"
              }
            },
            {
              "contains": {
                "const": "SEARCH"
              }
            },
            {
              "contains": {
                "const": "CANDIDATE_FORMATION"
              }
            },
            {
              "contains": {
                "const": "COUNTEREXAMPLE_SEARCH"
              }
            },
            {
              "contains": {
                "const": "VALIDATION"
              }
            },
            {
              "contains": {
                "const": "CERTIFICATE_RENDERING"
              }
            },
            {
              "contains": {
                "const": "EVIDENCE_ADAPTATION"
              }
            }
          ]
        },
        "contentHash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
