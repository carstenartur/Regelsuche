{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-candidate-formation-receipt/v2",
  "title": "Regelsuche autonomous candidate formation receipt v2",
  "type": "object",
  "required": [
    "schema", "briefHash", "stage", "disposition", "resources",
    "decisionHashes", "miningEvidenceHashes", "aggregateReceiptHashes",
    "outputBranchIds", "rejectedClusterHashes", "targetProvided",
    "receiptIsMathematicalEvidence", "promotionStatus",
    "publicEvidenceStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-candidate-formation-receipt/v2" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "stage": { "const": "CANDIDATE_FORMATION" },
    "disposition": { "const": "COMPLETED" },
    "resources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["resource", "configured", "executed", "skipped", "remaining"],
        "properties": {
          "resource": { "enum": ["MINING_BATCHES", "CANDIDATES", "WALL_CLOCK_MILLIS"] },
          "configured": { "type": "integer", "minimum": 1 },
          "executed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "remaining": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "decisionHashes": { "$ref": "#/$defs/twoOrMoreHashes" },
    "miningEvidenceHashes": { "$ref": "#/$defs/twoOrMoreHashes" },
    "aggregateReceiptHashes": { "$ref": "#/$defs/twoOrMoreHashes" },
    "outputBranchIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlank" }
    },
    "rejectedClusterHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "targetProvided": { "const": false },
    "receiptIsMathematicalEvidence": { "const": false },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "twoOrMoreHashes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    }
  },
  "additionalProperties": false
}
