{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-campaign-plan/v1",
  "title": "Regelsuche deterministic autonomous campaign allocation plan v1",
  "type": "object",
  "required": [
    "schema", "briefHash", "ledgerHash", "policy",
    "plannerDecisionIsMathematicalEvidence", "decisions", "plannedBudget",
    "promotionStatus", "publicEvidenceStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-campaign-plan/v1" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "ledgerHash": { "$ref": "#/$defs/sha256" },
    "policy": {
      "enum": ["ROUND_ROBIN", "EVIDENCE_COMPLETION_FIRST", "COUNTEREXAMPLE_RISK_FIRST", "BALANCED"]
    },
    "plannerDecisionIsMathematicalEvidence": { "const": false },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["branchId", "branchSnapshotHash", "kind", "stage", "budgetDeltas", "reason", "constraints"],
        "properties": {
          "branchId": { "$ref": "#/$defs/nonBlank" },
          "branchSnapshotHash": { "$ref": "#/$defs/sha256" },
          "kind": { "enum": ["ALLOCATE", "STOP", "NO_ACTION"] },
          "stage": { "type": "string", "minLength": 1 },
          "budgetDeltas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["resource", "amount"],
              "properties": {
                "resource": { "$ref": "#/$defs/resource" },
                "amount": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "reason": { "$ref": "#/$defs/nonBlank" },
          "constraints": { "$ref": "#/$defs/stringArray" }
        },
        "additionalProperties": false
      }
    },
    "plannedBudget": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["stage", "resource", "amount"],
        "properties": {
          "stage": { "$ref": "#/$defs/stage" },
          "resource": { "$ref": "#/$defs/resource" },
          "amount": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "stage": { "enum": ["GENERATION", "CANDIDATE_FORMATION", "VALIDATION", "COUNTEREXAMPLE_SEARCH", "PROOF"] },
    "resource": { "enum": ["WALL_CLOCK_MILLIS", "GENERATED_STATES", "EXPLORED_STATES", "CANDIDATES", "VALIDATION_CHECKS", "COUNTEREXAMPLE_ATTEMPTS", "PROOF_ATTEMPTS"] },
    "nonBlank": { "type": "string", "minLength": 1 },
    "stringArray": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
