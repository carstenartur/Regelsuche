{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.capability-status/v1",
  "title": "Regelsuche public capability and claim status v1",
  "type": "object",
  "required": [
    "schema",
    "policy",
    "repositoryRevision",
    "sourceEvidence",
    "capabilities",
    "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.capability-status/v1"},
    "policy": {"const": "EVIDENCE_DERIVED_FAIL_CLOSED"},
    "repositoryRevision": {
      "oneOf": [
        {"const": "WORKTREE"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "sourceEvidence": {
      "type": "object",
      "required": [
        "releaseReadinessReportHash",
        "releaseReadinessRunHash",
        "domainGenericQualificationReportHash",
        "domainGenericQualificationRunHash"
      ],
      "properties": {
        "releaseReadinessReportHash": {"$ref": "#/$defs/sha256"},
        "releaseReadinessRunHash": {"$ref": "#/$defs/sha256"},
        "domainGenericQualificationReportHash": {"$ref": "#/$defs/sha256"},
        "domainGenericQualificationRunHash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 12,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "contentHash": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{1,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonBlank": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "object",
      "required": [
        "capability",
        "status",
        "claim",
        "evidenceRoots",
        "blockers",
        "notes"
      ],
      "properties": {
        "capability": {"$ref": "#/$defs/identifier"},
        "status": {
          "enum": [
            "IMPLEMENTED",
            "QUALIFIED",
            "EXPERIMENTAL",
            "BLOCKED",
            "NOT_EVALUATED",
            "OUT_OF_SCOPE"
          ]
        },
        "claim": {"$ref": "#/$defs/nonBlank"},
        "evidenceRoots": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "blockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonBlank"}
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["IMPLEMENTED", "QUALIFIED"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "blockers": {"maxItems": 0},
              "evidenceRoots": {"minItems": 1}
            }
          }
        }
      ],
      "additionalProperties": false
    }
  }
}
