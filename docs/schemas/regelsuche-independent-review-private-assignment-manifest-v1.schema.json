{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-independent-review-private-assignment-manifest-v1.schema.json",
  "title": "Regelsuche private blind-review assignment manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","studyPlanHash","publicManifestHash","reviewerHashSaltCommitment","assignmentCount","assignments","privacyClassification","reviewCollectionStatus","promotionStatus","publicEvidenceStatus","contentHash"],
  "properties": {
    "schema": {"const": "regelsuche.independent-review-private-assignment-manifest/v1"},
    "studyPlanHash": {"$ref": "#/$defs/sha256"},
    "publicManifestHash": {"$ref": "#/$defs/sha256"},
    "reviewerHashSaltCommitment": {"$ref": "#/$defs/sha256"},
    "assignmentCount": {"type": "integer", "minimum": 1},
    "assignments": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/assignment"}},
    "privacyClassification": {"const": "PRIVATE_ACCESS_CONTROLLED"},
    "reviewCollectionStatus": {"const": "NOT_COLLECTED"},
    "promotionStatus": {"const": "NOT_EVALUATED"},
    "publicEvidenceStatus": {"const": "NOT_EVALUATED"},
    "contentHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$"},
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignmentId","packetId","packetContentHash","reviewerHash","caseId","candidateId","split","candidateFamily","candidateArtifactHash","assessmentContentHash","blindedPresentationHash","contentHash"],
      "properties": {
        "assignmentId": {"$ref": "#/$defs/identifier"},
        "packetId": {"type": "string", "pattern": "^packet-[0-9a-f]{24}$"},
        "packetContentHash": {"$ref": "#/$defs/sha256"},
        "reviewerHash": {"$ref": "#/$defs/sha256"},
        "caseId": {"$ref": "#/$defs/identifier"},
        "candidateId": {"$ref": "#/$defs/identifier"},
        "split": {"enum": ["CALIBRATION","TEST"]},
        "candidateFamily": {"type": "string", "minLength": 1},
        "candidateArtifactHash": {"$ref": "#/$defs/sha256"},
        "assessmentContentHash": {"$ref": "#/$defs/sha256"},
        "blindedPresentationHash": {"$ref": "#/$defs/sha256"},
        "contentHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
