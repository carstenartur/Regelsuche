{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-held-out-split-references-v1.schema.json",
  "title": "Regelsuche public held-out split references",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "studyId",
    "split",
    "revealBundleHash",
    "cases",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-held-out-split-references/v1"
    },
    "studyId": {"$ref": "#/$defs/id"},
    "split": {
      "enum": ["VALIDATION", "FINAL_TEST"]
    },
    "revealBundleHash": {"$ref": "#/$defs/sha256"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "contentHash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "familyId",
        "exactSignatureHash",
        "alphaSignatureHash",
        "inputHash",
        "hiddenTargetHash"
      ],
      "properties": {
        "caseId": {"$ref": "#/$defs/id"},
        "familyId": {"$ref": "#/$defs/id"},
        "exactSignatureHash": {"$ref": "#/$defs/sha256"},
        "alphaSignatureHash": {"$ref": "#/$defs/sha256"},
        "inputHash": {"$ref": "#/$defs/sha256"},
        "hiddenTargetHash": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
