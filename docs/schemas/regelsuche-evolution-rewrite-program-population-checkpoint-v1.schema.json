{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-population-checkpoint-v1.schema.json",
  "title": "Regelsuche rewrite-program population checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "studyPlanHash",
    "trainSuiteHash",
    "mutationCatalogHash",
    "seedCandidateHashes",
    "completedGeneration",
    "populationCandidateHashes",
    "evaluationHashes",
    "generationReportHashes",
    "mutationAttempts",
    "trainEvaluations",
    "validationStatus",
    "finalTestStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-population-checkpoint/v1"
    },
    "studyPlanHash": {
      "$ref": "#/$defs/sha256"
    },
    "trainSuiteHash": {
      "$ref": "#/$defs/sha256"
    },
    "mutationCatalogHash": {
      "$ref": "#/$defs/sha256"
    },
    "seedCandidateHashes": {
      "$ref": "#/$defs/nonEmptyHashes"
    },
    "completedGeneration": {
      "type": "integer",
      "minimum": 1
    },
    "populationCandidateHashes": {
      "$ref": "#/$defs/nonEmptyHashes"
    },
    "evaluationHashes": {
      "$ref": "#/$defs/nonEmptyHashes"
    },
    "generationReportHashes": {
      "$ref": "#/$defs/nonEmptyHashes"
    },
    "mutationAttempts": {
      "type": "integer",
      "minimum": 0
    },
    "trainEvaluations": {
      "type": "integer",
      "minimum": 0
    },
    "validationStatus": {
      "const": "NOT_EVALUATED"
    },
    "finalTestStatus": {
      "const": "NOT_EVALUATED"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nonEmptyHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    }
  }
}
