{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-paired-task-utility-v1.schema.json",
  "title": "Exact-one-candidate paired downstream utility",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "benchmarkId", "challengeId", "repositoryRevision",
    "caseCorpusContentHash", "freezeReceiptContentHash",
    "combinedPreregistrationHash", "downstreamTaskStreamContentHash",
    "baselineInventoryProfileId", "baselineInventoryContentHash",
    "comparisonPolicy", "formationAccessPolicy", "candidateSelectionPolicy",
    "candidateInventoryPolicy", "formedCandidateCount", "enabledCandidateCount",
    "formationReplayEvidence", "formedCandidates", "candidateSelection",
    "configuredTasks", "executedTasks", "aggregateOutcomeCounts",
    "correctnessRegressionCount", "resourceUse", "formalProofStatus",
    "externalNoveltyStatus", "publicationAuthorized", "tasks", "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.paired-task-utility/v1"},
    "benchmarkId": {"const": "regelsuche-candidate-independent-autonomous-discovery-2026-07/v1"},
    "challengeId": {"const": "reusable-search-macros"},
    "repositoryRevision": {"type": "string", "minLength": 1},
    "caseCorpusContentHash": {"$ref": "#/$defs/hash"},
    "freezeReceiptContentHash": {"$ref": "#/$defs/hash"},
    "combinedPreregistrationHash": {"$ref": "#/$defs/hash"},
    "downstreamTaskStreamContentHash": {"$ref": "#/$defs/hash"},
    "baselineInventoryProfileId": {"const": "macro-primitives/v1"},
    "baselineInventoryContentHash": {"$ref": "#/$defs/hash"},
    "comparisonPolicy": {"const": "IDENTICAL_INPUT_TARGET_INVENTORY_STRATEGY_AND_BUDGET"},
    "formationAccessPolicy": {"const": "TRAIN_ONLY"},
    "candidateSelectionPolicy": {"const": "MAX_TRAIN_SUPPORT_THEN_CANONICAL_HASH_THEN_MACRO_ID"},
    "candidateInventoryPolicy": {"const": "BASELINE_PLUS_EXACTLY_ONE_SELECTED_CANDIDATE"},
    "formedCandidateCount": {"const": 3},
    "enabledCandidateCount": {"const": 1},
    "formationReplayEvidence": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/replayEvidence"}
    },
    "formedCandidates": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "candidateSelection": {"$ref": "#/$defs/selection"},
    "configuredTasks": {"const": 12},
    "executedTasks": {"const": 12},
    "aggregateOutcomeCounts": {"$ref": "#/$defs/outcomeCounts"},
    "correctnessRegressionCount": {"const": 0},
    "resourceUse": {"$ref": "#/$defs/resourceUse"},
    "formalProofStatus": {"const": "NOT_EVALUATED"},
    "externalNoveltyStatus": {"const": "NOT_EVALUATED"},
    "publicationAuthorized": {"const": false},
    "tasks": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {"$ref": "#/$defs/task"}
    },
    "contentHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nonEmptyStringArray": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "outcomeCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "IMPROVED", "REACHABILITY_GAIN", "NO_IMPROVEMENT", "NO_RESULT",
        "CORRECTNESS_REGRESSION", "CANDIDATE_NOT_FORMED"
      ],
      "properties": {
        "IMPROVED": {"type": "integer", "minimum": 0, "maximum": 12},
        "REACHABILITY_GAIN": {"type": "integer", "minimum": 0, "maximum": 12},
        "NO_IMPROVEMENT": {"type": "integer", "minimum": 0, "maximum": 12},
        "NO_RESULT": {"type": "integer", "minimum": 0, "maximum": 12},
        "CORRECTNESS_REGRESSION": {"const": 0},
        "CANDIDATE_NOT_FORMED": {"const": 0}
      }
    },
    "replayEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traceId", "reproduced", "exploredStates", "actualRuleIds",
        "assignedOperationIds", "compressedOperationIds", "expressionPath",
        "detail", "contentHash"
      ],
      "properties": {
        "traceId": {"type": "string", "pattern": "^case-(13|14)-trace-[12]$"},
        "reproduced": {"const": true},
        "exploredStates": {"type": "integer", "minimum": 1},
        "actualRuleIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "assignedOperationIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "compressedOperationIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "expressionPath": {"$ref": "#/$defs/nonEmptyStringArray"},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "macroId", "operationSequence", "supportingTraceIds", "trainSupport",
        "leftPattern", "rightPattern", "parameterRelations", "assumptions",
        "proofStatus", "knownRuleStatus", "supportingExamples",
        "occurrenceCount", "confidenceScore", "canonicalHash",
        "validationEvidence", "atomicSteps", "contentHash"
      ],
      "properties": {
        "macroId": {"type": "string", "pattern": "^macro_candidate_independent_[0-9a-f]+$"},
        "operationSequence": {"$ref": "#/$defs/nonEmptyStringArray"},
        "supportingTraceIds": {"$ref": "#/$defs/nonEmptyStringArray"},
        "trainSupport": {"type": "integer", "minimum": 1, "maximum": 4},
        "leftPattern": {"type": "string", "minLength": 1},
        "rightPattern": {"type": "string", "minLength": 1},
        "parameterRelations": {"$ref": "#/$defs/stringArray"},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "proofStatus": {"const": "SYMBOLICALLY_VERIFIED"},
        "knownRuleStatus": {"type": "string", "minLength": 1},
        "supportingExamples": {"type": "integer", "minimum": 1},
        "occurrenceCount": {"type": "integer", "minimum": 1},
        "confidenceScore": {"const": 1.0},
        "canonicalHash": {"type": "string", "minLength": 1},
        "validationEvidence": {"type": "string", "minLength": 1},
        "atomicSteps": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/atomicStep"}
        },
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy", "selectedCandidateId", "selectedCandidateContentHash",
        "selectedTrainSupport", "formedCandidateCount", "contentHash"
      ],
      "properties": {
        "policy": {"const": "MAX_TRAIN_SUPPORT_THEN_CANONICAL_HASH_THEN_MACRO_ID"},
        "selectedCandidateId": {"type": "string", "pattern": "^macro_candidate_independent_[0-9a-f]+$"},
        "selectedCandidateContentHash": {"$ref": "#/$defs/hash"},
        "selectedTrainSupport": {"type": "integer", "minimum": 1, "maximum": 4},
        "formedCandidateCount": {"const": 3},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "atomicStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "beforeExpression", "afterExpression", "ruleId", "ruleKind",
        "scoreBefore", "scoreAfter", "equivalencePreserving", "explanation",
        "assumptions", "contentHash"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "beforeExpression": {"type": "string"},
        "afterExpression": {"type": "string"},
        "ruleId": {"type": "string", "minLength": 1},
        "ruleKind": {"enum": ["SIMPLIFY", "NORMALIZE", "EXPAND", "FACTOR"]},
        "scoreBefore": {"type": "integer"},
        "scoreAfter": {"type": "integer"},
        "equivalencePreserving": {"const": true},
        "explanation": {"type": "string"},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "taskBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDepth", "maxExpandedStates"],
      "properties": {
        "maxDepth": {"type": "integer", "minimum": 0},
        "maxExpandedStates": {"type": "integer", "minimum": 1}
      }
    },
    "searchRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success", "reachedExpression", "path", "ruleIds", "expandedStates",
        "generatedCandidates", "budgetExhausted", "detail", "contentHash"
      ],
      "properties": {
        "success": {"type": "boolean"},
        "reachedExpression": {"type": "string"},
        "path": {"$ref": "#/$defs/stringArray"},
        "ruleIds": {"$ref": "#/$defs/stringArray"},
        "expandedStates": {"type": "integer", "minimum": 0},
        "generatedCandidates": {"type": "integer", "minimum": 0},
        "budgetExhausted": {"type": "boolean"},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "resourceDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expandedStateSaving", "generatedCandidateSaving", "pathStepSaving",
        "contentHash"
      ],
      "properties": {
        "expandedStateSaving": {"type": "integer"},
        "generatedCandidateSaving": {"type": "integer"},
        "pathStepSaving": {"type": "integer"},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index", "taskId", "caseId", "split", "structuralCluster",
        "streamTaskContentHash", "source", "target", "assumptions",
        "searchBudget", "comparisonPolicy", "candidateInventoryPolicy",
        "enabledCandidateIds", "outcome", "correctnessRegression", "baseline",
        "candidateEnabled", "resourceDelta", "detail", "contentHash"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 1, "maximum": 12},
        "taskId": {"type": "string", "pattern": "^case-(1[3-8])-task-[12]$"},
        "caseId": {"type": "string", "pattern": "^case-(1[3-8])$"},
        "split": {"enum": ["TRAIN", "VALIDATION", "TEST"]},
        "structuralCluster": {"type": "string", "minLength": 1},
        "streamTaskContentHash": {"$ref": "#/$defs/hash"},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "assumptions": {"$ref": "#/$defs/stringArray"},
        "searchBudget": {"$ref": "#/$defs/taskBudget"},
        "comparisonPolicy": {"const": "IDENTICAL_INPUT_TARGET_INVENTORY_STRATEGY_AND_BUDGET"},
        "candidateInventoryPolicy": {"const": "BASELINE_PLUS_EXACTLY_ONE_SELECTED_CANDIDATE"},
        "enabledCandidateIds": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {"type": "string", "pattern": "^macro_candidate_independent_[0-9a-f]+$"}
        },
        "outcome": {"enum": [
          "IMPROVED", "REACHABILITY_GAIN", "NO_IMPROVEMENT", "NO_RESULT",
          "CORRECTNESS_REGRESSION", "CANDIDATE_NOT_FORMED"
        ]},
        "correctnessRegression": {"const": false},
        "baseline": {"$ref": "#/$defs/searchRun"},
        "candidateEnabled": {"$ref": "#/$defs/searchRun"},
        "resourceDelta": {"$ref": "#/$defs/resourceDelta"},
        "detail": {"type": "string", "minLength": 1},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    },
    "resourceUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "configuredStates", "executedStates", "remainingStates",
        "configuredCandidateEvaluations", "executedCandidateEvaluations",
        "remainingCandidateEvaluations", "configuredProofAttempts",
        "executedProofAttempts", "remainingProofAttempts", "formationStates",
        "formationCandidateEvaluations", "baselineExpandedStates",
        "candidateExpandedStates", "expandedStateSaving",
        "baselineGeneratedCandidates", "candidateGeneratedCandidates",
        "generatedCandidateSaving", "baselinePathSteps", "candidatePathSteps",
        "pathStepSaving", "contentHash"
      ],
      "properties": {
        "configuredStates": {"const": 3000},
        "executedStates": {"type": "integer", "minimum": 1, "maximum": 3000},
        "remainingStates": {"type": "integer", "minimum": 0, "maximum": 2999},
        "configuredCandidateEvaluations": {"const": 600},
        "executedCandidateEvaluations": {"type": "integer", "minimum": 1, "maximum": 600},
        "remainingCandidateEvaluations": {"type": "integer", "minimum": 0, "maximum": 599},
        "configuredProofAttempts": {"const": 100},
        "executedProofAttempts": {"const": 0},
        "remainingProofAttempts": {"const": 100},
        "formationStates": {"type": "integer", "minimum": 1},
        "formationCandidateEvaluations": {"type": "integer", "minimum": 1},
        "baselineExpandedStates": {"type": "integer", "minimum": 0},
        "candidateExpandedStates": {"type": "integer", "minimum": 0},
        "expandedStateSaving": {"type": "integer"},
        "baselineGeneratedCandidates": {"type": "integer", "minimum": 0},
        "candidateGeneratedCandidates": {"type": "integer", "minimum": 0},
        "generatedCandidateSaving": {"type": "integer"},
        "baselinePathSteps": {"type": "integer", "minimum": 0},
        "candidatePathSteps": {"type": "integer", "minimum": 0},
        "pathStepSaving": {"type": "integer"},
        "contentHash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
