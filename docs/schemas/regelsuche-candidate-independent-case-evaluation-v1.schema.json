{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://carstenartur.github.io/Regelsuche/schemas/regelsuche-candidate-independent-case-evaluation-v1.schema.json","title":"Regelsuche candidate-independent case evaluation v1","type":"object","additionalProperties":false,"required":["schema","benchmarkId","campaignId","campaignContentHash","caseId","challengeId","split","formationVisibility","candidateFormationStatus","heldOutEvaluationStatus","executionStatus","outcome","failures","resourceUse","publicationEligible","contentHash"],"properties":{"schema":{"const":"regelsuche.candidate-independent-case-evaluation/v1"},"benchmarkId":{"type":"string","minLength":1},"campaignId":{"type":"string","pattern":"^[a-z0-9-]+-campaign-[0-9]{2}$"},"campaignContentHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"caseId":{"type":"string","pattern":"^case-[0-9]{2}$"},"challengeId":{"enum":["finite-difference-recurrences","rational-assumption-rewrites","reusable-search-macros"]},"split":{"enum":["TRAIN","VALIDATION","TEST"]},"formationVisibility":{"enum":["ALLOWED","PROHIBITED"]},"candidateFormationStatus":{"const":"NOT_RUN"},"heldOutEvaluationStatus":{"const":"NOT_RUN"},"executionStatus":{"const":"NOT_EXECUTED"},"outcome":{"const":"INCOMPLETE"},"failures":{"type":"array","minItems":1,"maxItems":1,"items":{"const":"EXECUTION_ADAPTER_NOT_IMPLEMENTED"}},"resourceUse":{"type":"object","additionalProperties":false,"required":["exploredStates","generatedSuccessors","candidateEvaluations","proofAttempts"],"properties":{"exploredStates":{"const":0},"generatedSuccessors":{"const":0},"candidateEvaluations":{"const":0},"proofAttempts":{"const":0}}},"publicationEligible":{"const":false},"contentHash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
