{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.proof-carrying-showcase-seed-receipt/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "showcaseId",
    "planContentHash",
    "candidateFreezeContentHash",
    "randomnessReceiptContentHash",
    "drandChainHash",
    "drandRound",
    "derivationAlgorithm",
    "derivedSeed",
    "status",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.proof-carrying-showcase-seed-receipt/v1"
    },
    "showcaseId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160
    },
    "planContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidateFreezeContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "randomnessReceiptContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "drandChainHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "drandRound": {
      "type": "integer",
      "minimum": 1
    },
    "derivationAlgorithm": {
      "const": "SHA256_DOMAIN_SEPARATED_V1"
    },
    "derivedSeed": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {
      "const": "FINAL_TEST_SEED_DERIVED_AFTER_CANDIDATE_FREEZE"
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
