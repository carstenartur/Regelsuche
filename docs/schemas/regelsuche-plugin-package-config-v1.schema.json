{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-package-config/v1",
  "type": "object",
  "required": [
    "schema",
    "packageDirectory",
    "installationId",
    "trustDomain",
    "pinnedRoots",
    "authority",
    "allowedOrigins",
    "connectTimeoutSeconds",
    "responseTimeoutSeconds",
    "limits",
    "sources",
    "selection"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-package-config/v1"
    },
    "packageDirectory": {
      "type": "string",
      "minLength": 1
    },
    "installationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "trustDomain": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "pinnedRoots": {
      "$ref": "regelsuche-plugin-trust-store-v1.schema.json"
    },
    "authority": {
      "type": "object",
      "required": [
        "jdbcUrl",
        "user",
        "passwordEnvironment",
        "tlsRootCertificate",
        "timeoutSeconds"
      ],
      "properties": {
        "jdbcUrl": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "passwordEnvironment": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "tlsRootCertificate": {
          "type": "string",
          "minLength": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      },
      "additionalProperties": false
    },
    "allowedOrigins": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "connectTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "responseTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "limits": {
      "type": "object",
      "required": [
        "metadataBytes",
        "artifactBytes",
        "totalBytes",
        "maximumArtifacts",
        "maximumHistory"
      ],
      "properties": {
        "metadataBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483639
        },
        "artifactBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483639
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483639
        },
        "maximumArtifacts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "maximumHistory": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "trustStoreUri",
            "trustRevisionUri",
            "indexUri",
            "indexSignatureUri",
            "indexId",
            "indexRevision",
            "indexContentHash"
          ],
          "properties": {
            "trustStoreUri": {
              "type": "string",
              "format": "uri"
            },
            "trustRevisionUri": {
              "type": "string",
              "format": "uri"
            },
            "indexUri": {
              "type": "string",
              "format": "uri"
            },
            "indexSignatureUri": {
              "type": "string",
              "format": "uri"
            },
            "indexId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "indexRevision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "indexContentHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "selection": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "requestId",
            "componentId",
            "version",
            "coreVersion",
            "apiVersion",
            "requiredCapabilities"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "componentId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "coreVersion": {
              "type": "string",
              "minLength": 1
            },
            "apiVersion": {
              "type": "string",
              "minLength": 1
            },
            "requiredCapabilities": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false
}
