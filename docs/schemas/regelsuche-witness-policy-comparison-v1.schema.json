{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.witness-policy-comparison/v1",
  "title": "Regelsuche witness policy comparison v1",
  "type": "object",
  "required": [
    "schema",
    "evidenceStatus",
    "corpusSchema",
    "corpusSha256",
    "atlasRunHash",
    "atlasSha256",
    "scalarDiagnosticHash",
    "inventoryRevision",
    "scalarPolicy",
    "diversityPolicy",
    "budgetPolicy",
    "claimBoundary",
    "cases",
    "summary",
    "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.witness-policy-comparison/v1"},
    "evidenceStatus": {"const": "EXECUTED_TARGET_BLIND_POLICY_COMPARISON"},
    "corpusSchema": {"const": "regelsuche.historical-rediscovery-corpus/v1"},
    "corpusSha256": {"$ref": "#/$defs/rawSha256"},
    "atlasRunHash": {"$ref": "#/$defs/prefixedSha256"},
    "atlasSha256": {"$ref": "#/$defs/prefixedSha256"},
    "scalarDiagnosticHash": {"$ref": "#/$defs/prefixedSha256"},
    "inventoryRevision": {"$ref": "#/$defs/text"},
    "scalarPolicy": {"const": "SCALAR_BEST_FIRST_TARGET_BLIND"},
    "diversityPolicy": {"const": "STRUCTURAL_DIVERSITY_TARGET_BLIND"},
    "budgetPolicy": {"const": "SAME_DECLARED_SEARCH_HEURISTIC_ACTUAL_WORK_RETAINED_SEPARATELY"},
    "claimBoundary": {"const": "The target-aware oracle supplies a bounded diagnostic witness only after both target-blind policies complete. Prefix recovery is not proof, autonomous rediscovery, external novelty or general superiority."},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "contentHash": {"$ref": "#/$defs/prefixedSha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "NOT_APPLICABLE",
        "SCALAR_ALREADY_FOUND",
        "DIVERSITY_REACHED_RELATION",
        "DIVERSITY_EXPLORED_FULL_WITNESS",
        "DIVERSITY_EXTENDED_PREFIX",
        "NO_PREFIX_GAIN",
        "DIVERSITY_SHORTER_PREFIX"
      ]
    },
    "budget": {
      "type": "object",
      "required": ["maxDepth", "maxVisitedStates", "maxCandidatesPerState", "maxExpandingSteps", "beamWidth"],
      "properties": {
        "maxDepth": {"type": "integer", "minimum": 0},
        "maxVisitedStates": {"type": "integer", "minimum": 1},
        "maxCandidatesPerState": {"type": "integer", "minimum": 1},
        "maxExpandingSteps": {"type": "integer", "minimum": 0},
        "beamWidth": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "policyRun": {
      "type": "object",
      "required": ["reached", "exploredPrefixLength", "exploredStates", "engineCalls", "generatedTransformations", "path", "ruleIds", "detail"],
      "properties": {
        "reached": {"type": "boolean"},
        "exploredPrefixLength": {"type": "integer", "minimum": 0},
        "exploredStates": {"type": "integer", "minimum": 0},
        "engineCalls": {"type": "integer", "minimum": 0},
        "generatedTransformations": {"type": "integer", "minimum": 0},
        "path": {"type": "array", "items": {"type": "string"}},
        "ruleIds": {"type": "array", "items": {"type": "string"}},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["id", "status", "oracleStatus", "witnessStepCount", "declaredBudget", "scalar", "diversity", "prefixGain", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/status"},
        "oracleStatus": {"$ref": "#/$defs/text"},
        "witnessStepCount": {"type": "integer", "minimum": 0},
        "declaredBudget": {"$ref": "#/$defs/budget"},
        "scalar": {"$ref": "#/$defs/policyRun"},
        "diversity": {"$ref": "#/$defs/policyRun"},
        "prefixGain": {"type": "integer"},
        "detail": {"type": "string"}
      },
      "additionalProperties": false
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "summary": {
      "type": "object",
      "required": ["caseCount", "comparedCaseCount", "positivePrefixGainCount", "diversityReachedCount", "regressionCount", "statusCounts"],
      "properties": {
        "caseCount": {"type": "integer", "minimum": 1},
        "comparedCaseCount": {"type": "integer", "minimum": 0},
        "positivePrefixGainCount": {"type": "integer", "minimum": 0},
        "diversityReachedCount": {"type": "integer", "minimum": 0},
        "regressionCount": {"type": "integer", "minimum": 0},
        "statusCounts": {"$ref": "#/$defs/countMap"}
      },
      "additionalProperties": false
    }
  }
}
