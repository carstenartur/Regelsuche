{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.witness-policy-comparison/v1",
  "title": "Regelsuche witness policy comparison v1",
  "type": "object",
  "required": [
    "schema",
    "evidenceStatus",
    "corpusSchema",
    "corpusSha256",
    "atlasRunHash",
    "atlasSha256",
    "scalarDiagnosticHash",
    "inventoryRevision",
    "scalarPolicy",
    "diversityPolicy",
    "budgetPolicy",
    "claimBoundary",
    "cases",
    "summary",
    "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.witness-policy-comparison/v1"},
    "evidenceStatus": {"const": "EXECUTED_TARGET_BLIND_POLICY_COMPARISON"},
    "corpusSchema": {"const": "regelsuche.historical-rediscovery-corpus/v1"},
    "corpusSha256": {"$ref": "#/$defs/rawSha256"},
    "atlasRunHash": {"$ref": "#/$defs/prefixedSha256"},
    "atlasSha256": {"$ref": "#/$defs/prefixedSha256"},
    "scalarDiagnosticHash": {"$ref": "#/$defs/prefixedSha256"},
    "inventoryRevision": {"$ref": "#/$defs/text"},
    "scalarPolicy": {"const": "SCALAR_BEST_FIRST_TARGET_BLIND"},
    "diversityPolicy": {"const": "STRUCTURAL_DIVERSITY_TARGET_BLIND"},
    "budgetPolicy": {"const": "SAME_DECLARED_SEARCH_HEURISTIC_ACTUAL_WORK_RETAINED_SEPARATELY"},
    "claimBoundary": {"const": "The target-aware oracle is inspected only after both target-blind policies complete. Prefix recovery is not proof, autonomous rediscovery, external novelty or general superiority."},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "contentHash": {"$ref": "#/$defs/prefixedSha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 4096},
    "rawSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "prefixedSha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {
      "enum": [
        "NOT_APPLICABLE",
        "SCALAR_ALREADY_FOUND",
        "DIVERSITY_REACHED_RELATION",
        "DIVERSITY_EXPLORED_FULL_WITNESS",
        "DIVERSITY_EXTENDED_PREFIX",
        "NO_PREFIX_GAIN",
        "DIVERSITY_SHORTER_PREFIX"
      ]
    },
    "work": {
      "type": "object",
      "required": ["exploredStates", "engineCalls", "generatedTransformations"],
      "properties": {
        "exploredStates": {"type": "integer", "minimum": 0},
        "engineCalls": {"type": "integer", "minimum": 0},
        "generatedTransformations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "required": ["beamWidth", "maxCandidatesPerState", "maxDepth", "maxExpandingSteps", "maxVisitedStates"],
      "properties": {
        "beamWidth": {"type": "integer", "minimum": 1},
        "maxCandidatesPerState": {"type": "integer", "minimum": 1},
        "maxDepth": {"type": "integer", "minimum": 0},
        "maxExpandingSteps": {"type": "integer", "minimum": 0},
        "maxVisitedStates": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "status",
        "oracleStatus",
        "witnessStepCount",
        "scalarPrefixLength",
        "diversityPrefixLength",
        "prefixGain",
        "scalarFirstLossReason",
        "diversityReached",
        "scalarWork",
        "diversityWork",
        "declaredBudget"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "status": {"$ref": "#/$defs/status"},
        "oracleStatus": {"$ref": "#/$defs/text"},
        "witnessStepCount": {"type": "integer", "minimum": 0},
        "scalarPrefixLength": {"type": "integer", "minimum": 0},
        "diversityPrefixLength": {"type": ["integer", "null"], "minimum": 0},
        "prefixGain": {"type": ["integer", "null"]},
        "scalarFirstLossReason": {"type": "string"},
        "diversityReached": {"type": "boolean"},
        "scalarWork": {"$ref": "#/$defs/work"},
        "diversityWork": {"$ref": "#/$defs/work"},
        "declaredBudget": {"$ref": "#/$defs/budget"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {"enum": ["NOT_APPLICABLE", "SCALAR_ALREADY_FOUND"]}
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "diversityPrefixLength": {"type": "null"},
              "prefixGain": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "diversityPrefixLength": {"type": "integer", "minimum": 0},
              "prefixGain": {"type": "integer"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "caseCount",
        "comparedCaseCount",
        "positivePrefixGainCount",
        "diversityReachedCount",
        "regressionCount",
        "statusCounts"
      ],
      "properties": {
        "caseCount": {"type": "integer", "minimum": 1},
        "comparedCaseCount": {"type": "integer", "minimum": 0},
        "positivePrefixGainCount": {"type": "integer", "minimum": 0},
        "diversityReachedCount": {"type": "integer", "minimum": 0},
        "regressionCount": {"type": "integer", "minimum": 0},
        "statusCounts": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
