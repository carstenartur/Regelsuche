{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-trust-store-revision/v1",
  "title": "Regelsuche signed plugin trust-store revision v1",
  "type": "object",
  "required": [
    "schema",
    "trustDomainId",
    "sequence",
    "previousRevisionHash",
    "trustStoreContentHash",
    "authorityId",
    "keyId",
    "algorithm",
    "signatureBase64",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-trust-store-revision/v1"
    },
    "trustDomainId": {
      "$ref": "#/$defs/identifier"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "previousRevisionHash": {
      "$ref": "#/$defs/sha256OrEmpty"
    },
    "trustStoreContentHash": {
      "$ref": "#/$defs/sha256"
    },
    "authorityId": {
      "$ref": "#/$defs/identifier"
    },
    "keyId": {
      "$ref": "#/$defs/identifier"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "signatureBase64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "previousRevisionHash": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "previousRevisionHash": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sha256OrEmpty": {
      "oneOf": [
        {
          "const": ""
        },
        {
          "$ref": "#/$defs/sha256"
        }
      ]
    }
  }
}
