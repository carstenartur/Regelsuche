{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.campaign-budget-ledger/v1",
  "title": "Regelsuche campaign budget ledger v1",
  "type": "object",
  "required": ["schema", "briefHash", "lines", "contentHash"],
  "properties": {
    "schema": { "const": "regelsuche.campaign-budget-ledger/v1" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["stage", "resource", "configured", "executed", "skipped", "remaining"],
        "properties": {
          "stage": { "$ref": "#/$defs/stage" },
          "resource": { "$ref": "#/$defs/resource" },
          "configured": { "type": "integer", "minimum": 0 },
          "executed": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "remaining": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "stage": { "enum": ["GENERATION", "CANDIDATE_FORMATION", "VALIDATION", "COUNTEREXAMPLE_SEARCH", "PROOF"] },
    "resource": { "enum": ["WALL_CLOCK_MILLIS", "GENERATED_STATES", "EXPLORED_STATES", "CANDIDATES", "VALIDATION_CHECKS", "COUNTEREXAMPLE_ATTEMPTS", "PROOF_ATTEMPTS"] },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
