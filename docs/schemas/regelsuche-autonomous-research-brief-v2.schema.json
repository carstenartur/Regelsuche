{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-research-brief/v2",
  "title": "Regelsuche aggregate autonomous research brief v2",
  "type": "object",
  "required": [
    "schema", "briefId", "v1BriefHash", "deterministicSeed",
    "enabledStages", "stageBudgets", "minimumAggregateInputs",
    "minimumSupportDiversity", "minimumAlphaDiversity",
    "outputNamespace", "promotionStatus", "publicEvidenceStatus",
    "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-research-brief/v2" },
    "briefId": { "$ref": "#/$defs/nonBlank" },
    "v1BriefHash": { "$ref": "#/$defs/sha256" },
    "deterministicSeed": { "type": "integer" },
    "enabledStages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stage" },
      "allOf": [
        { "contains": { "const": "GENERATION" } },
        { "contains": { "const": "CANDIDATE_FORMATION" } },
        { "contains": { "const": "PROJECT_NOVELTY" } },
        { "contains": { "const": "LIFECYCLE_HANDOFF" } }
      ]
    },
    "stageBudgets": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": ["stage", "resources"],
        "properties": {
          "stage": { "$ref": "#/$defs/stage" },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["resource", "configured"],
              "properties": {
                "resource": { "$ref": "#/$defs/resource" },
                "configured": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "minimumAggregateInputs": { "type": "integer", "minimum": 2 },
    "minimumSupportDiversity": { "type": "integer", "minimum": 2 },
    "minimumAlphaDiversity": { "type": "integer", "minimum": 2 },
    "outputNamespace": { "$ref": "#/$defs/nonBlank" },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "stage": { "enum": ["GENERATION", "CANDIDATE_FORMATION", "VALIDATION", "COUNTEREXAMPLE_SEARCH", "PROJECT_NOVELTY", "PROOF", "LIFECYCLE_HANDOFF"] },
    "resource": { "enum": ["WALL_CLOCK_MILLIS", "GENERATED_STATES", "EXPLORED_STATES", "CANDIDATES", "VALIDATION_CHECKS", "COUNTEREXAMPLE_ATTEMPTS", "NOVELTY_CHECKS", "PROOF_ATTEMPTS", "LIFECYCLE_HANDOFFS"] },
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
