{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-feedback-reallocation/v2",
  "title": "Regelsuche autonomous feedback and reallocation decision v2",
  "type": "object",
  "required": [
    "schema", "briefHash", "currentPlanHash", "successfulExecutionHash",
    "rejectedExecutionHash", "lifecycleDecisionHash",
    "candidateFormationReceiptHash", "downstreamStageLedgerHash",
    "completedCandidateBranchIds", "rejectedClusterHashes",
    "eligibleBranchIds", "nextPlanHash", "nextDecisionCount",
    "disposition", "reasonCodes", "usesOnlyRetainedEvidence",
    "feedbackIsMathematicalEvidence", "externalNoveltyEvaluated",
    "promotionStatus", "publicEvidenceStatus", "contentHash"
  ],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-feedback-reallocation/v2" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "currentPlanHash": { "$ref": "#/$defs/sha256" },
    "successfulExecutionHash": { "$ref": "#/$defs/sha256" },
    "rejectedExecutionHash": { "$ref": "#/$defs/sha256" },
    "lifecycleDecisionHash": { "$ref": "#/$defs/sha256" },
    "candidateFormationReceiptHash": { "$ref": "#/$defs/sha256" },
    "downstreamStageLedgerHash": { "$ref": "#/$defs/sha256" },
    "completedCandidateBranchIds": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "uniqueItems": true, "items": { "$ref": "#/$defs/nonBlank" }
    },
    "rejectedClusterHashes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "eligibleBranchIds": { "type": "array", "maxItems": 0 },
    "nextPlanHash": { "$ref": "#/$defs/sha256" },
    "nextDecisionCount": { "const": 0 },
    "disposition": { "const": "CAMPAIGN_COMPLETE" },
    "reasonCodes": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonBlank" }
    },
    "usesOnlyRetainedEvidence": { "const": true },
    "feedbackIsMathematicalEvidence": { "const": false },
    "externalNoveltyEvaluated": { "const": false },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "nonBlank": { "type": "string", "minLength": 1 },
    "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "additionalProperties": false
}
