{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carstenartur.github.io/Regelsuche/schemas/regelsuche-exact-rational-scalar-v1.schema.json",
  "title": "Regelsuche exact rational scalar parse evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domainId",
    "status",
    "detailCode",
    "sourceLiteral",
    "limits",
    "canonicalValue",
    "valueId",
    "certificateHash"
  ],
  "properties": {
    "domainId": {
      "const": "regelsuche.exact-rational-scalar/v1"
    },
    "status": {
      "enum": [
        "EXACT",
        "UNSUPPORTED",
        "ZERO_DENOMINATOR",
        "LIMIT_EXCEEDED"
      ]
    },
    "detailCode": {
      "enum": [
        "EXACT_RATIONAL_LITERAL_ACCEPTED",
        "LITERAL_BLANK",
        "LITERAL_GRAMMAR_UNSUPPORTED",
        "RATIONAL_DENOMINATOR_ZERO",
        "LITERAL_CHARACTER_LIMIT_EXCEEDED",
        "RATIONAL_DIGIT_LIMIT_EXCEEDED",
        "INTEGER_DIGIT_LIMIT_EXCEEDED",
        "DECIMAL_DIGIT_LIMIT_EXCEEDED",
        "DECIMAL_SCALE_LIMIT_EXCEEDED"
      ]
    },
    "sourceLiteral": {
      "type": "string",
      "maxLength": 4096
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxLiteralCharacters",
        "maxDigits",
        "maxDecimalScale"
      ],
      "properties": {
        "maxLiteralCharacters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        },
        "maxDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "maxDecimalScale": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        }
      }
    },
    "canonicalValue": {
      "type": "string"
    },
    "valueId": {
      "type": "string"
    },
    "certificateHash": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXACT"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "detailCode": {
            "const": "EXACT_RATIONAL_LITERAL_ACCEPTED"
          },
          "sourceLiteral": {
            "minLength": 1,
            "pattern": "^[+-]?[0-9]+(?:\\s*/\\s*[+-]?[0-9]+|\\.[0-9]+)?$"
          },
          "canonicalValue": {
            "pattern": "^(?:0|-?[1-9][0-9]*|-?[1-9][0-9]*/[1-9][0-9]*)$"
          },
          "valueId": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "certificateHash": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "canonicalValue": {
            "const": ""
          },
          "valueId": {
            "const": ""
          },
          "certificateHash": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "UNSUPPORTED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "detailCode": {
            "enum": [
              "LITERAL_BLANK",
              "LITERAL_GRAMMAR_UNSUPPORTED"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ZERO_DENOMINATOR"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "detailCode": {
            "const": "RATIONAL_DENOMINATOR_ZERO"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "LIMIT_EXCEEDED"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "detailCode": {
            "enum": [
              "LITERAL_CHARACTER_LIMIT_EXCEEDED",
              "RATIONAL_DIGIT_LIMIT_EXCEEDED",
              "INTEGER_DIGIT_LIMIT_EXCEEDED",
              "DECIMAL_DIGIT_LIMIT_EXCEEDED",
              "DECIMAL_SCALE_LIMIT_EXCEEDED"
            ]
          }
        }
      }
    }
  ]
}
