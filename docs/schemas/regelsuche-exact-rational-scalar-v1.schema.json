{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carstenartur/Regelsuche/blob/main/docs/schemas/regelsuche-exact-rational-scalar-v1.schema.json",
  "title": "Regelsuche exact rational scalar parse evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domainId",
    "status",
    "detailCode",
    "sourceLiteral",
    "canonicalValue",
    "valueId",
    "certificateHash"
  ],
  "properties": {
    "domainId": {
      "const": "regelsuche.exact-rational-scalar/v1"
    },
    "status": {
      "enum": [
        "EXACT",
        "UNSUPPORTED",
        "ZERO_DENOMINATOR",
        "LIMIT_EXCEEDED"
      ]
    },
    "detailCode": {
      "type": "string",
      "minLength": 1
    },
    "sourceLiteral": {
      "type": "string"
    },
    "canonicalValue": {
      "type": "string"
    },
    "valueId": {
      "type": "string"
    },
    "certificateHash": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "EXACT"
          }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "canonicalValue": {
            "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"
          },
          "valueId": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "certificateHash": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "canonicalValue": {
            "const": ""
          },
          "valueId": {
            "const": ""
          },
          "certificateHash": {
            "const": ""
          }
        }
      }
    }
  ]
}
