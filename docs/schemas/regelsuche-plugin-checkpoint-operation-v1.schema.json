{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-checkpoint-operation/v1",
  "type": "object",
  "required": [
    "schema",
    "scope",
    "operationId",
    "intentHash",
    "expected",
    "update"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-checkpoint-operation/v1"
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "intentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "expected": {
      "$ref": "#/$defs/state"
    },
    "update": {
      "allOf": [
        {
          "$ref": "#/$defs/state"
        },
        {
          "properties": {
            "installationHash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "checkpoint": {
              "$ref": "regelsuche-plugin-trust-store-chain-checkpoint-v1.schema.json"
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scope": {
      "type": "object",
      "required": [
        "installationId",
        "trustDomain",
        "rootTrustStoreHash"
      ],
      "properties": {
        "installationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "trustDomain": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "rootTrustStoreHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "required": [
        "installationHash",
        "checkpoint"
      ],
      "properties": {
        "installationHash": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "const": ""
            }
          ]
        },
        "checkpoint": {
          "anyOf": [
            {
              "$ref": "regelsuche-plugin-trust-store-chain-checkpoint-v1.schema.json"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "installationHash": {
                "const": ""
              }
            }
          },
          "then": {
            "properties": {
              "checkpoint": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "checkpoint": {
                "$ref": "regelsuche-plugin-trust-store-chain-checkpoint-v1.schema.json"
              }
            }
          }
        }
      ]
    }
  }
}
