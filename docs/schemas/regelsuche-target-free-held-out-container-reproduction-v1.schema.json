{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.target-free-held-out-container-reproduction/v1",
  "title": "Target-free held-out host and container reproduction receipt v1",
  "type": "object",
  "required": [
    "schema",
    "evidenceStatus",
    "repository",
    "repositoryRevision",
    "matrix",
    "container",
    "runs",
    "artifacts",
    "comparison",
    "claimBoundary",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.target-free-held-out-container-reproduction/v1"
    },
    "evidenceStatus": {
      "const": "HOST_REPEAT_AND_PINNED_CONTAINER_BYTE_IDENTICAL"
    },
    "repository": {"const": "carstenartur/Regelsuche"},
    "repositoryRevision": {"$ref": "#/$defs/revision"},
    "matrix": {
      "type": "object",
      "required": [
        "caseCount",
        "policyCount",
        "checkpointCount",
        "configuredRows",
        "matchedWorkGroups",
        "exactCheckpointRows",
        "eligibleMatchedWorkGroups",
        "qualifiedPositiveRows",
        "qualifiedCandidates",
        "negativeControlPassedRows",
        "negativeControlViolations"
      ],
      "properties": {
        "caseCount": {"const": 6},
        "policyCount": {"const": 4},
        "checkpointCount": {"const": 6},
        "configuredRows": {"const": 144},
        "matchedWorkGroups": {"const": 36},
        "exactCheckpointRows": {"type": "integer", "minimum": 0, "maximum": 144},
        "eligibleMatchedWorkGroups": {"type": "integer", "minimum": 0, "maximum": 36},
        "qualifiedPositiveRows": {"type": "integer", "minimum": 0, "maximum": 120},
        "qualifiedCandidates": {"type": "integer", "minimum": 0},
        "negativeControlPassedRows": {"type": "integer", "minimum": 0, "maximum": 24},
        "negativeControlViolations": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "container": {
      "type": "object",
      "required": [
        "definitionPath",
        "definitionSha256",
        "baseImage",
        "baseImageDigest",
        "builtImageId",
        "platform",
        "runtimeUser",
        "buildNetworkPolicy",
        "evaluatedRunNetworkPolicy",
        "gradleDistributionSha256"
      ],
      "properties": {
        "definitionPath": {
          "const": "Dockerfile.target-free-held-out-reproduction"
        },
        "definitionSha256": {"$ref": "#/$defs/sha256"},
        "baseImage": {
          "const": "eclipse-temurin:25.0.3_9-jdk-noble@sha256:3eb81ed94d8c1a34422f19f8188548bdf02cae69c91d0328afdbb7abed90f617"
        },
        "baseImageDigest": {
          "const": "sha256:3eb81ed94d8c1a34422f19f8188548bdf02cae69c91d0328afdbb7abed90f617"
        },
        "builtImageId": {"$ref": "#/$defs/sha256"},
        "platform": {"const": "linux/amd64"},
        "runtimeUser": {"const": "reproducer:10001"},
        "buildNetworkPolicy": {"const": "DEPENDENCY_RESOLUTION_ONLY"},
        "evaluatedRunNetworkPolicy": {"const": "DISABLED"},
        "gradleDistributionSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "runs": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/hostRunA"},
        {"$ref": "#/$defs/hostRunB"},
        {"$ref": "#/$defs/containerRun"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "artifacts": {
      "type": "array",
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "path": {"const": "target-free-held-out-candidate-freeze.json"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "path": {"const": "target-free-held-out-plan.json"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/artifact"},
            {
              "properties": {
                "path": {"const": "target-free-held-out-post-freeze-qualification.json"}
              }
            }
          ]
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "comparison": {
      "type": "object",
      "required": ["hostRepeat", "hostContainer", "expectedFiles"],
      "properties": {
        "hostRepeat": {"const": "BYTE_IDENTICAL"},
        "hostContainer": {"const": "BYTE_IDENTICAL"},
        "expectedFiles": {
          "const": [
            "target-free-held-out-candidate-freeze.json",
            "target-free-held-out-plan.json",
            "target-free-held-out-post-freeze-qualification.json"
          ]
        }
      },
      "additionalProperties": false
    },
    "claimBoundary": {"type": "string", "minLength": 100},
    "contentHash": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "required": ["path", "byteLength", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "byteLength": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "hostRunA": {
      "type": "object",
      "required": ["id", "environment", "artifactSetHash"],
      "properties": {
        "id": {"const": "HOST_A"},
        "environment": {"const": "CHECKOUT_JVM"},
        "artifactSetHash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "hostRunB": {
      "type": "object",
      "required": ["id", "environment", "artifactSetHash"],
      "properties": {
        "id": {"const": "HOST_B"},
        "environment": {"const": "CHECKOUT_JVM"},
        "artifactSetHash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "containerRun": {
      "type": "object",
      "required": ["id", "environment", "artifactSetHash"],
      "properties": {
        "id": {"const": "PINNED_CONTAINER"},
        "environment": {"const": "DIGEST_PINNED_LINUX_CONTAINER"},
        "artifactSetHash": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
