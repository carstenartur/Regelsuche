{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.dev/schemas/regelsuche-evolution-rewrite-program-train-fitness-v1.schema.json",
  "title": "Regelsuche rewrite-program paired TRAIN fitness",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "suiteHash",
    "evaluationProtocolHash",
    "candidateHash",
    "genomeHash",
    "planHash",
    "cases",
    "rawComponents",
    "blockers",
    "validationStatus",
    "finalTestStatus",
    "proofStatus",
    "externalNoveltyStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-rewrite-program-train-fitness/v1"
    },
    "suiteHash": {
      "$ref": "#/$defs/sha256"
    },
    "evaluationProtocolHash": {
      "$ref": "#/$defs/sha256"
    },
    "candidateHash": {
      "$ref": "#/$defs/sha256"
    },
    "genomeHash": {
      "$ref": "#/$defs/sha256"
    },
    "planHash": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "rawComponents": {
      "$ref": "#/$defs/rawComponents"
    },
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "validationStatus": {
      "const": "NOT_EVALUATED"
    },
    "finalTestStatus": {
      "const": "NOT_EVALUATED"
    },
    "proofStatus": {
      "const": "NOT_EVALUATED"
    },
    "externalNoveltyStatus": {
      "const": "NOT_EVALUATED"
    },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{2,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "status": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "pathCorrectness": {
      "enum": [
        "CONFIRMED",
        "REFUTED",
        "MISSING_ASSUMPTION",
        "UNSUPPORTED",
        "NOT_EVALUATED"
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "familyId",
        "baselineStatus",
        "candidateStatus",
        "baselineReached",
        "candidateReached",
        "baselinePathCorrectness",
        "candidatePathCorrectness",
        "baselinePathLength",
        "candidatePathLength",
        "baselinePrimitiveSteps",
        "candidatePrimitiveSteps",
        "baselineExploredStates",
        "candidateExploredStates",
        "baselineGeneratedTransformations",
        "candidateGeneratedTransformations",
        "programUsed",
        "newlySolved",
        "reachabilityRegression",
        "correctnessFailure",
        "correctnessRegression"
      ],
      "properties": {
        "caseId": {
          "$ref": "#/$defs/id"
        },
        "familyId": {
          "$ref": "#/$defs/id"
        },
        "baselineStatus": {
          "$ref": "#/$defs/status"
        },
        "candidateStatus": {
          "$ref": "#/$defs/status"
        },
        "baselineReached": {
          "type": "boolean"
        },
        "candidateReached": {
          "type": "boolean"
        },
        "baselinePathCorrectness": {
          "$ref": "#/$defs/pathCorrectness"
        },
        "candidatePathCorrectness": {
          "$ref": "#/$defs/pathCorrectness"
        },
        "baselinePathLength": {
          "type": "integer",
          "minimum": -1
        },
        "candidatePathLength": {
          "type": "integer",
          "minimum": -1
        },
        "baselinePrimitiveSteps": {
          "type": "integer",
          "minimum": 0
        },
        "candidatePrimitiveSteps": {
          "type": "integer",
          "minimum": 0
        },
        "baselineExploredStates": {
          "type": "integer",
          "minimum": 0
        },
        "candidateExploredStates": {
          "type": "integer",
          "minimum": 0
        },
        "baselineGeneratedTransformations": {
          "type": "integer",
          "minimum": 0
        },
        "candidateGeneratedTransformations": {
          "type": "integer",
          "minimum": 0
        },
        "programUsed": {
          "type": "boolean"
        },
        "newlySolved": {
          "type": "boolean"
        },
        "reachabilityRegression": {
          "type": "boolean"
        },
        "correctnessFailure": {
          "type": "boolean"
        },
        "correctnessRegression": {
          "type": "boolean"
        }
      }
    },
    "rawComponents": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "TRAIN_CASES_NEWLY_SOLVED",
          "TRAIN_PATH_LENGTH_REDUCTION",
          "TRAIN_EXPLORED_STATE_REDUCTION",
          "SUPPORT",
          "STRUCTURAL_DIVERSITY",
          "PROJECT_NOVELTY",
          "ASSUMPTION_SIMPLICITY",
          "CANDIDATE_COMPLEXITY",
          "COUNTEREXAMPLE_RISK",
          "PROOF_COST_PROXY"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": -1000,
        "maximum": 1000
      }
    }
  }
}
