{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.evolution-population-run/v1",
  "title": "Regelsuche evolution population run v1",
  "type": "object",
  "required": [
    "schema",
    "studyPlanHash",
    "seedGenomeHashes",
    "generationReportHashes",
    "finalPopulationGenomeHashes",
    "finalPopulationAlphaStructuralHashes",
    "terminalOutcome",
    "budgetUsed",
    "validationStatus",
    "finalTestStatus",
    "proofStatus",
    "externalNoveltyStatus",
    "promotionStatus",
    "publicEvidenceStatus",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.evolution-population-run/v1"
    },
    "studyPlanHash": {
      "$ref": "#/$defs/sha256"
    },
    "seedGenomeHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "generationReportHashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "finalPopulationGenomeHashes": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "finalPopulationAlphaStructuralHashes": {
      "type": "array",
      "maxItems": 100000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    },
    "terminalOutcome": {
      "enum": [
        "COMPLETED",
        "EXTINCT",
        "STAGNATED",
        "DIVERSITY_FLOOR_UNMET",
        "MUTATION_BUDGET_EXHAUSTED",
        "TRAIN_EVALUATION_BUDGET_EXHAUSTED"
      ]
    },
    "budgetUsed": {
      "$ref": "#/$defs/budget"
    },
    "validationStatus": { "const": "NOT_EVALUATED" },
    "finalTestStatus": { "const": "NOT_EVALUATED" },
    "proofStatus": { "const": "NOT_EVALUATED" },
    "externalNoveltyStatus": { "const": "NOT_EVALUATED" },
    "promotionStatus": { "const": "NOT_EVALUATED" },
    "publicEvidenceStatus": { "const": "NOT_EVALUATED" },
    "contentHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "budget": {
      "type": "object",
      "required": ["mutationAttempts", "trainEvaluations"],
      "properties": {
        "mutationAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "trainEvaluations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
