{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.plugin-installation/v1",
  "title": "Immutable package generation evidence",
  "type": "object",
  "required": [
    "schema",
    "operation",
    "previousInstallationHash",
    "rollbackSourceHash",
    "checkpoint",
    "rootTrustStoreHash",
    "trustStoreHash",
    "indexId",
    "indexRevision",
    "indexContentHash",
    "resolutionContentHash",
    "artifacts",
    "files",
    "contentHash"
  ],
  "properties": {
    "schema": {
      "const": "regelsuche.plugin-installation/v1"
    },
    "operation": {
      "enum": [
        "INSTALL",
        "UPDATE",
        "REMOVE",
        "ROLLBACK"
      ]
    },
    "previousInstallationHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "rollbackSourceHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "checkpoint": {
      "type": "object",
      "required": [
        "schema",
        "trustDomainId",
        "sequence",
        "revisionHash",
        "contentHash"
      ],
      "properties": {
        "schema": {
          "const": "regelsuche.plugin-trust-store-chain-checkpoint/v1"
        },
        "trustDomainId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "revisionHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "rootTrustStoreHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "trustStoreHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "indexId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "const": ""
        }
      ]
    },
    "indexRevision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        {
          "const": ""
        }
      ]
    },
    "indexContentHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "resolutionContentHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "const": ""
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "componentId",
          "version",
          "identityHash",
          "artifactSha256",
          "publisherId",
          "path",
          "provenanceContentHash",
          "verificationContentHash"
        ],
        "properties": {
          "kind": {
            "enum": [
              "JAVA_PLUGIN",
              "RULE_PACKAGE",
              "KNOWLEDGE_PACK"
            ]
          },
          "componentId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "identityHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "publisherId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
          },
          "provenanceContentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "verificationContentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "ROLLBACK"
          }
        }
      },
      "then": {
        "properties": {
          "rollbackSourceHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "else": {
        "properties": {
          "rollbackSourceHash": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifacts": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "indexId": {
            "const": ""
          },
          "indexRevision": {
            "const": ""
          },
          "indexContentHash": {
            "const": ""
          },
          "resolutionContentHash": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "indexId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "indexRevision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "indexContentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resolutionContentHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  ]
}
