{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "regelsuche.autonomous-production-observations/v2",
  "title": "Regelsuche autonomous immutable production observations v2",
  "type": "object",
  "required": ["schema", "briefHash", "targetProvided", "observations", "contentHash"],
  "properties": {
    "schema": { "const": "regelsuche.autonomous-production-observations/v2" },
    "briefHash": { "$ref": "#/$defs/sha256" },
    "targetProvided": { "const": false },
    "observations": {
      "type": "array",
      "minItems": 12,
      "items": { "$ref": "#/$defs/observation" }
    },
    "contentHash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "observationId", "branchId", "familyId", "seedId",
        "seedExpression", "generator", "domain", "tags", "assumptions",
        "searchStatus", "metrics", "states", "selectedExpression",
        "selectedPath", "selectedRuleIds", "snapshotHash", "evidenceHash",
        "branchHash"
      ],
      "properties": {
        "observationId": { "$ref": "#/$defs/nonBlank" },
        "branchId": { "$ref": "#/$defs/nonBlank" },
        "familyId": { "$ref": "#/$defs/nonBlank" },
        "seedId": { "$ref": "#/$defs/nonBlank" },
        "seedExpression": { "$ref": "#/$defs/nonBlank" },
        "generator": { "$ref": "#/$defs/nonBlank" },
        "domain": { "$ref": "#/$defs/nonBlank" },
        "tags": { "$ref": "#/$defs/strings" },
        "assumptions": { "$ref": "#/$defs/strings" },
        "searchStatus": { "const": "UNTARGETED" },
        "metrics": {
          "type": "object",
          "required": [
            "exploredStates", "expandedStates",
            "generatedTransformations", "enqueuedStates"
          ],
          "properties": {
            "exploredStates": { "type": "integer", "minimum": 1 },
            "expandedStates": { "type": "integer", "minimum": 1 },
            "generatedTransformations": { "type": "integer", "minimum": 0 },
            "enqueuedStates": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "expression", "depth", "canonicalHash", "scoreWeightedTotal",
              "path", "appliedRuleIds", "equivalencePreservingFlags",
              "assumptions"
            ],
            "properties": {
              "expression": { "$ref": "#/$defs/nonBlank" },
              "depth": { "type": "integer", "minimum": 0 },
              "canonicalHash": { "$ref": "#/$defs/nonBlank" },
              "scoreWeightedTotal": { "type": "integer" },
              "path": { "$ref": "#/$defs/strings" },
              "appliedRuleIds": { "$ref": "#/$defs/strings" },
              "equivalencePreservingFlags": {
                "type": "array",
                "items": { "type": "boolean" }
              },
              "assumptions": { "$ref": "#/$defs/strings" }
            },
            "additionalProperties": false
          }
        },
        "selectedExpression": { "$ref": "#/$defs/nonBlank" },
        "selectedPath": { "$ref": "#/$defs/strings" },
        "selectedRuleIds": { "$ref": "#/$defs/strings" },
        "snapshotHash": { "$ref": "#/$defs/sha256" },
        "evidenceHash": { "$ref": "#/$defs/sha256" },
        "branchHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "nonBlank": { "type": "string", "minLength": 1 },
    "strings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
