{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regelsuche.de/schemas/regelsuche-learned-rewrite-program-authorization-receipt-v1.schema.json",
  "title": "Regelsuche learned rewrite-program authorization receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "authorizerId",
    "candidateHash",
    "genomeHash",
    "genomeAlphaStructuralHash",
    "planHash",
    "planAlphaStructuralHash",
    "repositoryRevision",
    "authorizedAt",
    "validUntil",
    "replayEvidenceHash",
    "leafAuthorizationHashes",
    "workRevisions",
    "contentHash"
  ],
  "properties": {
    "schema": {"const": "regelsuche.learned-rewrite-program-authorization-receipt/v1"},
    "authorizerId": {"const": "regelsuche.learned-rewrite-program-authorizer/v1"},
    "candidateHash": {"$ref": "#/$defs/hash"},
    "genomeHash": {"$ref": "#/$defs/hash"},
    "genomeAlphaStructuralHash": {"$ref": "#/$defs/hash"},
    "planHash": {"$ref": "#/$defs/hash"},
    "planAlphaStructuralHash": {"$ref": "#/$defs/hash"},
    "repositoryRevision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorizedAt": {"type": "string", "format": "date-time"},
    "validUntil": {"type": "string", "format": "date-time"},
    "replayEvidenceHash": {"$ref": "#/$defs/hash"},
    "leafAuthorizationHashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/hash"},
      "propertyNames": {"minLength": 1}
    },
    "workRevisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "contentHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
