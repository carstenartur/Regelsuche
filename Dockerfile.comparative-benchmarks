FROM eclipse-temurin:25.0.5_8-jdk-noble AS build
WORKDIR /workspace

COPY . .
RUN chmod +x ./gradlew \
    && ./gradlew --no-daemon --no-configuration-cache :regelsuche-benchmarks:installDist :app:test \
        --tests de.regelsuche.docs.HiddenRuleComparisonTest \
        --tests de.regelsuche.docs.HiddenRulePilotCampaignTest.productionRuntimeContainsNoHiddenManifestIdentifiersOrTemplates

ARG REGELSUCHE_PREPARATION_REVISION
RUN REGELSUCHE_PREPARATION_REVISION="$REGELSUCHE_PREPARATION_REVISION" \
    ./gradlew --no-daemon --no-configuration-cache :regelsuche-experiments:test \
        --tests de.regelsuche.benchmark.PreparationAblationTest \
        --tests de.regelsuche.benchmark.PreparationGuardPanelTest \
        --tests de.regelsuche.benchmark.PreparationStageAttributionTest

FROM eclipse-temurin:25.0.5_8-jre-noble AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        python3 \
        python3-venv \
        z3=4.8.12-3.1build1 \
    && python3 -m venv /opt/regelsuche-sympy \
    && /opt/regelsuche-sympy/bin/python -m pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        sympy==1.14.0 mpmath==1.3.0 \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 regelsuche \
    && mkdir -p /output /opt/regelsuche-benchmarks \
    && chown -R regelsuche:regelsuche /output /opt/regelsuche-benchmarks

WORKDIR /opt/regelsuche-benchmarks
COPY --from=build \
    /workspace/regelsuche-benchmarks/build/install/regelsuche-benchmarks/ ./
COPY --from=build /workspace/app/build/reports/hidden-rule-pilot/comparison.json ./hidden-rule-comparison.json
COPY --from=build /workspace/regelsuche-experiments/build/reports/preparation-ablation/ /opt/regelsuche-benchmarks/preparation-ablation/
RUN chown -R regelsuche:regelsuche /opt/regelsuche-benchmarks

ENV HOME=/tmp
ENV REGELSUCHE_SYMPY_PYTHON=/opt/regelsuche-sympy/bin/python
USER regelsuche
COPY scripts/sympy_rule_reference/ /opt/regelsuche-sympy-reference/
RUN /opt/regelsuche-sympy/bin/python /opt/regelsuche-sympy-reference/reference.py --verify
VOLUME ["/output"]

ENTRYPOINT ["./bin/regelsuche-benchmarks"]
CMD ["/output"]
