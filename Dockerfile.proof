# syntax=docker/dockerfile:1.7
#
# Regelsuche **proof image** — same JVM runtime as the standard `Dockerfile`,
# but pre-installs Z3 and cvc5 from apt and (opt-in) the Lean toolchain via
# `elan`. Use this image when you want the JSON proof pipeline to actually
# call out to real provers instead of staying in skeleton mode.
#
# Build:
#     docker build -f Dockerfile.proof -t regelsuche-proof .
#
# Run (defaults to the file-backed persistence layer under
# /opt/regelsuche/data, with the proof workbench enabled):
#     docker run --rm -p 8080:8080 regelsuche-proof
#
# Build with Lean 4 (slow, ~1GB extra):
#     docker build -f Dockerfile.proof --build-arg INSTALL_LEAN=true \
#         -t regelsuche-proof-lean .

# ---------- Stage 1: Build (same as Dockerfile) ----------
FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace

COPY gradlew gradle.properties settings.gradle ./
COPY gradle ./gradle
COPY app/build.gradle ./app/build.gradle

RUN chmod +x ./gradlew \
    && ./gradlew --no-daemon --version

COPY app ./app

RUN ./gradlew --no-daemon :app:installDist -x test


# ---------- Stage 2: Runtime with provers ----------
FROM eclipse-temurin:21-jre AS runtime

ARG INSTALL_LEAN=false
ARG ELAN_GIT_SHA=3d5138e1526a569a23901b8ee559032793cf445e
ARG ELAN_INIT_SHA256=4bacca9502cb89736fe63d2685abc2947cfbf34dc87673504f1bb4c43eda9264

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    JAVA_OPTS="" \
    DEBIAN_FRONTEND=noninteractive

# Z3 and cvc5 are tiny (~10MB combined) so they go in unconditionally. The
# `--no-install-recommends` flag keeps the layer lean (pun intended).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        z3 \
        cvc5 \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/regelsuche

# Optional Lean 4 toolchain via elan. Skipped by default because elan + the
# Lean stable channel weigh in around 1 GB; opt in with --build-arg
# INSTALL_LEAN=true when you actually need the Lean worker to execute proofs.
RUN if [ "$INSTALL_LEAN" = "true" ]; then \
        curl -fsSLo /tmp/elan-init.sh https://raw.githubusercontent.com/leanprover/elan/${ELAN_GIT_SHA}/elan-init.sh \
        && echo "${ELAN_INIT_SHA256}  /tmp/elan-init.sh" | sha256sum -c - \
        && sh /tmp/elan-init.sh -y --default-toolchain leanprover/lean4:stable \
        && rm -f /tmp/elan-init.sh \
        && ln -s /root/.elan/bin/lean /usr/local/bin/lean \
        && ln -s /root/.elan/bin/lake /usr/local/bin/lake; \
    fi

# Non-root user for the runtime (matches the standard Dockerfile).
RUN useradd --create-home --uid 10001 regelsuche
COPY --from=build /workspace/app/build/install/app/ ./
RUN chown -R regelsuche:regelsuche /opt/regelsuche
USER regelsuche

EXPOSE 8080

# File-backed persistence + proof pipeline enabled. The proof env vars are
# documented in `de.regelsuche.proof.ProofConfig`; each one can be overridden
# with `-e REGELSUCHE_PROOF_…=…` at `docker run` time.
ENV REGELSUCHE_PERSISTENCE_MODE=JSON_FILE \
    REGELSUCHE_PERSISTENCE_PATH=/opt/regelsuche/data \
    REGELSUCHE_PROOF_ENABLED=true
RUN mkdir -p /opt/regelsuche/data
VOLUME ["/opt/regelsuche/data"]

ENTRYPOINT ["./bin/app"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8080"]
