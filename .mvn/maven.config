# Give transient Maven Central 429/503 responses more time to recover, including
# BOM imports resolved by automatic dependency submission before the build starts.
# Native HTTP transport honors Retry-After; otherwise waits grow from 10 to 50 s.
# Fail rather than wait longer than 60 s for any single retry.
-Daether.transport.http.retryHandler.count=5
-Daether.transport.http.retryHandler.interval=10000
-Daether.transport.http.retryHandler.intervalMax=60000
