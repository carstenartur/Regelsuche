FROM eclipse-temurin:25.0.3_9-jdk-noble AS build
WORKDIR /workspace

COPY . .
RUN chmod +x ./gradlew \
    && ./gradlew --no-daemon :regelsuche-release:installDist -x test

FROM eclipse-temurin:25.0.3_9-jre-noble AS runtime

RUN useradd --create-home --uid 10001 regelsuche \
    && mkdir -p /output /input \
    && chown -R regelsuche:regelsuche /output /input

WORKDIR /opt/regelsuche
COPY --from=build \
    /workspace/regelsuche-release/build/install/regelsuche-release/ ./
RUN chown -R regelsuche:regelsuche /opt/regelsuche

ENV HOME=/tmp
USER regelsuche
VOLUME ["/output"]

ENTRYPOINT ["./bin/regelsuche-release"]
CMD ["/output", "--qualify-candidate", "--require-ready"]
