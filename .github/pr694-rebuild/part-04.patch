+    private static void assertAppliedBudgetProjections(
+        TargetFreeRepresentationCandidateFreeze.FreezeContent content
+    ) {
+        for (var entry : content.entries()) {
+            var configured = entry.configuredBudget();
+            var applied = entry.appliedSearchBudget();
+            assertEquals(configured.maxDepth(), applied.maxDepth());
+            assertEquals(
+                configured.maxGeneratedTransitions(),
+                applied.maxGeneratedTransitions()
+            );
+            assertEquals(
+                configured.maxCandidatesPerState(),
+                applied.maxCandidatesPerState()
+            );
+            assertEquals(
+                configured.maxAstSizeIncreasePerStep(),
+                applied.maxAstSizeIncreasePerStep()
+            );
+            if (entry.policyId().equals("BOUNDED_ENUMERATION_V1")) {
+                assertEquals(
+                    TargetFreeRepresentationCandidateFreeze
+                        .BudgetProjectionKind.TARGET_FREE_ENUMERATION,
+                    applied.projectionKind()
+                );
+                assertEquals(
+                    configured.maxExploredStates(),
+                    applied.maxExploredStates()
+                );
+                assertEquals(0, applied.maxVisitedExpressions());
+                assertEquals(
+                    configured.maxRetainedStates(),
+                    applied.maxRetainedStates()
+                );
+                assertEquals(0, applied.significantImprovementThreshold());
+                assertEquals(0, applied.maxExpandingSteps());
+                assertEquals(0, applied.beamWidth());
+            } else {
+                int retainedLimit = Math.min(
+                    configured.maxExploredStates(),
+                    configured.maxRetainedStates()
+                );
+                assertEquals(
+                    TargetFreeRepresentationCandidateFreeze
+                        .BudgetProjectionKind.SEARCH_STRATEGY,
+                    applied.projectionKind()
+                );
+                assertEquals(0, applied.maxExploredStates());
+                assertEquals(
+                    retainedLimit,
+                    applied.maxVisitedExpressions()
+                );
+                assertEquals(retainedLimit, applied.maxRetainedStates());
+                assertEquals(
+                    configured.significantImprovementThreshold(),
+                    applied.significantImprovementThreshold()
+                );
+                assertEquals(
+                    configured.maxExpandingSteps(),
+                    applied.maxExpandingSteps()
+                );
+                assertEquals(configured.beamWidth(), applied.beamWidth());
+            }
+        }
+    }
